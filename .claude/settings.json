{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tooling/arch-check --claude-hook",
            "timeout": 30,
            "statusMessage": "Checking Cromarc's architecture rules"
          }
        ]
      }
    ]
  }
}
