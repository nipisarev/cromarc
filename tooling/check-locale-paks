# Hook H20 at work: every Cromarc string is in the app's English and Russian
# locale paks, with the text //cromarc/strings built for that locale. If the
# repack lost them, every Cromarc string would be blank in the app.
# Usage: tooling/check-locale-paks <out dir>/Cromarc.app
import glob
import os
import re
import sys

app = os.path.abspath(sys.argv[1])
out = os.path.dirname(app)
chromium = os.path.abspath(os.path.join(out, '..', '..'))
sys.path.insert(0, os.path.join(chromium, 'tools', 'grit'))
from grit.format import data_pack  # noqa: E402

header = os.path.join(out, 'gen', 'cromarc', 'strings', 'grit', 'cromarc_strings.h')
ids = {int(m.group(2)): m.group(1) for m in
       re.finditer(r'#define (IDS_CROMARC_\w+) (\d+)', open(header).read())}
if not ids:
  sys.exit(f'no Cromarc ids in {header}')
problems = []
for lproj, locale in (('en', 'en-US'), ('ru', 'ru')):
  # Versions/Current is a link to the one version.
  paks = sorted({os.path.realpath(p) for p in glob.glob(os.path.join(
      app, 'Contents', 'Frameworks', '*.framework', 'Versions', '*',
      'Resources', f'{lproj}.lproj', 'locale.pak'))})
  if len(paks) != 1:
    sys.exit(f'{lproj}.lproj/locale.pak: {len(paks)} found in {app}')
  shipped = data_pack.ReadDataPack(paks[0]).resources
  ours = data_pack.ReadDataPack(os.path.join(
      out, 'gen', 'cromarc', 'strings', f'cromarc_strings_{locale}.pak')).resources
  for id, name in sorted(ids.items()):
    if id not in shipped:
      problems.append(f'{lproj}: {name} ({id}) is not in the app')
    elif shipped[id] != ours[id]:
      problems.append(f'{lproj}: {name} ({id}) reads otherwise in the app')
if problems:
  print('\n'.join(problems[:20]), file=sys.stderr)
  sys.exit(f'{len(problems)} Cromarc string(s) wrong in the locale paks')
print(f'locale paks: all {len(ids)} Cromarc strings in en and ru')
