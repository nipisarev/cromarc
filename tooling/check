#
# Repository checks that need no Chromium checkout: shell syntax, shellcheck, tooling
# unit tests, unit tests of the WebUI code that runs without a browser (node --test).
# CI runs this same script.
# Usage: tooling/check

set -euo pipefail
cd "$(dirname "$0")/.."

scripts=(tooling/lib.sh tooling/bootstrap tooling/sync tooling/apply tooling/export-patches tooling/build
  tooling/check-patches tooling/bump tooling/zen-diff branding/build_icons
  tooling/check tooling/tests/*.sh)

echo "==> bash -n"
for f in "${scripts[@]}"; do bash -n "$f"; done

echo "==> shellcheck"
if command -v shellcheck >/dev/null; then
  shellcheck -x "${scripts[@]}"
else
  echo "shellcheck not installed (brew install shellcheck); skipped" >&2
  [ -z "${CI:-}" ] || exit 1
fi

echo "==> tests"
for t in tooling/tests/test_*.sh; do "$t"; done

echo "==> webui tests"
if command -v node >/dev/null; then
  node --test 'src/webui/*/tests/*_test.ts'
else
  echo "node not installed; skipped" >&2
  [ -z "${CI:-}" ] || exit 1
fi
