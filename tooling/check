#
# Repository checks that need no Chromium checkout: shell syntax, shellcheck, the
# architecture rules (tooling/arch-check), tooling unit tests, unit tests of the
# WebUI code that runs without a browser (node --test).
# CI runs this same script.
# Usage: tooling/check

set -euo pipefail
cd "$(dirname "$0")/.."

scripts=(tooling/lib.sh tooling/bootstrap tooling/sync tooling/apply tooling/export-patches tooling/build
  tooling/check-patches tooling/bump tooling/zen-diff tooling/test-browser tooling/install branding/build_icons
  tooling/check tooling/git-hooks/pre-commit tooling/git-hooks/commit-msg tooling/tests/*.sh)

echo "==> bash -n"
for f in "${scripts[@]}"; do bash -n "$f"; done

echo "==> shellcheck"
if command -v shellcheck >/dev/null; then
  shellcheck -x "${scripts[@]}"
else
  echo "shellcheck not installed (brew install shellcheck); skipped" >&2
  [ -z "${CI:-}" ] || exit 1
fi

echo "==> python syntax"
for f in tooling/arch-check tooling/check-headers tooling/check-locale-paks; do
  python3 -c 'import ast, sys; ast.parse(open(sys.argv[1]).read(), sys.argv[1])' "$f"
done

echo "==> architecture (AGENTS.md)"
tooling/arch-check --strict

echo "==> tests"
for t in tooling/tests/test_*.sh; do "$t"; done

echo "==> webui tests"
if command -v node >/dev/null; then
  # The loader gives the pages' imports of loadTimeData and /strings.m.js the
  # real strings (src/webui/i18n/tests); the strings check runs here too.
  node --import ./src/webui/i18n/tests/loader.mjs --test 'src/webui/*/tests/*_test.ts'
else
  echo "node not installed; skipped" >&2
  [ -z "${CI:-}" ] || exit 1
fi
