# Day-to-day development build for Apple Silicon. Copied verbatim into out/release/args.gn
# by tooling/build. Based on Stedding tooling/args/release.gn @ 8a15306 (BSD-3-Clause).

target_os = "mac"
target_cpu = "arm64"

# Optimised, single binary, no symbols: fastest full build on one machine.
is_debug = false
is_component_build = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0

# Google's remote build execution is not available outside Google.
use_remoteexec = false

# Field trials come from Google's variations server, which we never contact; the
# testing config would turn on experiments nobody chose.
disable_fieldtrial_testing_config = true

# H.264/AAC playback (YouTube, Slack video, most sites). Patent licensing matters only
# for distribution; revisit before publishing binaries.
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# The daily browser behaves as Chrome Stable on Chromium's own debug checks:
# DCHECKs log instead of crashing (a site that trips one in upstream code
# otherwise takes the whole browser down), and dangling raw_ptr detection is
# built in but off. Tests turn both back on and fatal:
#   --enable-features=DcheckIsFatal,PartitionAllocDanglingPtr
dcheck_is_configurable = true
enable_dangling_raw_ptr_feature_flag = false
