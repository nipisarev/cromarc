#
# Adapted from Stedding tooling/sync-chromium @ 8a15306, BSD-3-Clause:
# see third_party/stedding/LICENSE.
#
# Puts the Chromium tree at the pin from CHROMIUM_VERSION, outside this repository.
# Goes through depot_tools' git cache: a direct clone of chromium/src stalls on the
# ref advertisement of ~100k tags, the cache bootstraps from a bundle on Google Storage.
# Safe to re-run; moves an existing vanilla tree to the pin.
#
# Usage: tooling/sync [--nohooks]
#   CROMARC_SYNC_MIN_FREE_GB  free-disk floor, default 100 (checkout ~65 GB + release ~10 GB)

# shellcheck source=tooling/lib.sh
. "$(cd "$(dirname "$0")" && pwd)/lib.sh"

run_hooks=1
for arg in "$@"; do
  case "$arg" in
    --nohooks) run_hooks=0 ;;
    -h|--help) sed -n '9,16p' "$0"; exit 0 ;;
    *) die "unknown argument: $arg" ;;
  esac
done

require_macos_arm64 "$@"
add_depot_tools_to_path

min_free="${CROMARC_SYNC_MIN_FREE_GB:-100}"
case "$min_free" in ''|*[!0-9]*) die "CROMARC_SYNC_MIN_FREE_GB takes whole GB, got '$min_free'" ;; esac
require_free_gb "$CHROMIUM_ROOT" "$min_free"
require_no_ancestor_node_modules "$CHROMIUM_ROOT"

log "pin:   $CHROMIUM_TAG (M$CHROMIUM_MILESTONE, $CHROMIUM_CHANNEL)"
log "root:  $CHROMIUM_ROOT"
log "cache: $GIT_CACHE_PATH"
mkdir -p "$CHROMIUM_ROOT" "$GIT_CACHE_PATH"
cd "$CHROMIUM_ROOT" || die "cannot enter $CHROMIUM_ROOT"

log "populating the git cache for chromium/src (tens of GB, prints little while it downloads)"
git cache populate -v --cache-dir "$GIT_CACHE_PATH" --no-fetch-tags --ref "refs/tags/$CHROMIUM_TAG" "$CHROMIUM_URL"
cache_dir="$(git_cache_dir "$CHROMIUM_URL" || true)"
[ -n "$cache_dir" ] && [ -d "$cache_dir" ] || die "git cache reports no directory for $CHROMIUM_URL after populate"

if [ ! -f .gclient ]; then
  log "creating the gclient solution (unmanaged src)"
  gclient config --name src --unmanaged "$CHROMIUM_URL" --custom-var checkout_pgo_profiles=True
fi

if [ ! -d "$CHROMIUM_SRC/.git" ]; then
  log "cloning src from the local cache"
  git clone --no-checkout "$cache_dir" "$CHROMIUM_SRC"
  git -C "$CHROMIUM_SRC" remote set-url origin "$CHROMIUM_URL"
fi

if ! git -C "$CHROMIUM_SRC" rev-parse -q --verify "refs/tags/$CHROMIUM_TAG^{commit}" >/dev/null; then
  git -C "$CHROMIUM_SRC" fetch --no-tags "$cache_dir" "+refs/tags/$CHROMIUM_TAG:refs/tags/$CHROMIUM_TAG"
fi

if [ "$(git -C "$CHROMIUM_SRC" rev-parse --abbrev-ref HEAD 2>/dev/null || true)" = "cromarc-work" ]; then
  die "src is on cromarc-work (our patches). Not resetting it; move the pin through the patch workflow."
fi

log "checking out src at $CHROMIUM_TAG"
git -C "$CHROMIUM_SRC" checkout -f "refs/tags/$CHROMIUM_TAG"
actual="$(git -C "$CHROMIUM_SRC" rev-parse HEAD)"
[ "$actual" = "$CHROMIUM_COMMIT" ] || die "tag $CHROMIUM_TAG resolves to $actual, CHROMIUM_VERSION records $CHROMIUM_COMMIT. Tags are immutable: fix CHROMIUM_VERSION."

log "gclient sync (dependencies for $CHROMIUM_TAG)"
sync_args=(--force --reset --delete_unversioned_trees --with_tags)
[ "$run_hooks" -eq 0 ] && sync_args+=(--nohooks)
gclient sync "${sync_args[@]}"
[ "$run_hooks" -eq 1 ] && require_arm64_host_tools "$CHROMIUM_SRC"

log "checkout complete: $CHROMIUM_SRC @ $CHROMIUM_TAG ($actual)"
log "sizes: src=$(du -sh "$CHROMIUM_SRC" 2>/dev/null | cut -f1) cache=$(du -sh "$GIT_CACHE_PATH" 2>/dev/null | cut -f1), free $(free_gb "$CHROMIUM_ROOT") GB"
log "next: tooling/build release"
