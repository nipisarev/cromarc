#
# Stops a commit whose staged code breaks Cromarc's architecture rules
# (AGENTS.md): tooling/arch-check on the staged files, and the baseline of
# known violations only shrinks. Installed by tooling/bootstrap
# (core.hooksPath = tooling/git-hooks).

set -euo pipefail
root="$(git rev-parse --show-toplevel)"
"$root/tooling/arch-check" --root "$root" --staged
"$root/tooling/arch-check" --root "$root" --staged --baseline-grew HEAD
