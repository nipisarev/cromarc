From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolay Pisarev <nipisarev@gmail.com>
Date: Sat, 24 Oct 2026 00:14:16 +0200
Subject: [PATCH 1/7] Cromarc H0: build //cromarc into Chrome

//chrome/browser/ui links the //cromarc group (new Cromarc modules are added
there, not here), the WebUI configs see //cromarc:headers, //cromarc WebUIs
may use Lit, and the sidebar resources are packed into resources.pak with
their own grit ids.

diff --git a/chrome/browser/ui/BUILD.gn b/chrome/browser/ui/BUILD.gn
index 238f8625e42d8..04e9137cf57dd 100644
--- a/chrome/browser/ui/BUILD.gn
+++ b/chrome/browser/ui/BUILD.gn
@@ -2507,6 +2507,7 @@ static_library("ui") {
       "//chrome/browser/ui/webui/metrics_reporter:impl",
       "//chrome/browser/ui/webui/new_tab_footer",
       "//chrome/browser/ui/webui/new_tab_footer:impl",
+      "//cromarc",  # Cromarc
       "//chrome/browser/ui/webui/organizer_panel",
       "//chrome/browser/ui/webui/page_action_internals",
       "//chrome/browser/ui/webui/settings",
diff --git a/chrome/browser/ui/webui/BUILD.gn b/chrome/browser/ui/webui/BUILD.gn
index 7341632b43d34..0416facf1ef2e 100644
--- a/chrome/browser/ui/webui/BUILD.gn
+++ b/chrome/browser/ui/webui/BUILD.gn
@@ -53,6 +53,7 @@ source_set("configs") {
     ":signin_internals_ui",
     ":webui",
     "//chrome/browser/actor/ui:actor_overlay",
+    "//cromarc:headers",  # Cromarc
     "//chrome/browser/browser_actuator/internals",
     "//chrome/browser/contextual_tasks:ui",
     "//chrome/browser/glic",
diff --git a/chrome/chrome_paks.gni b/chrome/chrome_paks.gni
index 12a5e53584f9f..1ae206345213c 100644
--- a/chrome/chrome_paks.gni
+++ b/chrome/chrome_paks.gni
@@ -275,6 +275,11 @@ template("chrome_extra_paks") {
         "//components/headless/command_handler",
         "//content/browser/tracing:resources",
       ]
+
+      # Cromarc
+      sources += [ "$root_gen_dir/chrome/cromarc_resources.pak" ]
+      deps += [ "//cromarc/webui:resources" ]
+
       if (is_chrome_branded) {
         sources += [
           "$root_gen_dir/chrome/browser/nearby_sharing/internal/icons/nearby_share_internal_icons.pak",
diff --git a/third_party/lit/v3_0/BUILD.gn b/third_party/lit/v3_0/BUILD.gn
index a75e73285cf86..fb003daccc71b 100644
--- a/third_party/lit/v3_0/BUILD.gn
+++ b/third_party/lit/v3_0/BUILD.gn
@@ -12,6 +12,7 @@ import("//ui/webui/webui_features.gni")
 ts_library("build_ts") {
   visibility = [
     ":build_bundle",
+    "//cromarc/*",  # Cromarc
 
     # Lit has officially being declared as the preferred framework (over
     # Polymer) for new WebUI code, see [1] and [2]
diff --git a/tools/gritsettings/resource_ids.spec b/tools/gritsettings/resource_ids.spec
index 8749c14d44f1b..12a7de665c1d8 100644
--- a/tools/gritsettings/resource_ids.spec
+++ b/tools/gritsettings/resource_ids.spec
@@ -1799,6 +1799,12 @@
     "includes": [10140],
   },
 
+  # Cromarc
+  "<(SHARED_INTERMEDIATE_DIR)/cromarc/webui/resources.grd": {
+    "META": {"sizes": {"includes": [500]}},
+    "includes": [10300],
+  },
+
   "<(SHARED_INTERMEDIATE_DIR)/THIS_IS_A_PLACEHOLDER.grd": {
     "META": {"sizes": {"includes": [800]}},
     "includes": [12000],
