From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolay Pisarev <nipisarev@gmail.com>
Date: Sat, 24 Oct 2026 00:14:53 +0200
Subject: [PATCH] Cromarc H2: sidebar in the vertical tab strip region

The region keeps its layout, caption-button handling, resize and collapse;
the native tab list it adds is hidden and the Cromarc WebUI sidebar takes
its place.

diff --git a/chrome/browser/ui/views/frame/vertical_tab_strip_region_view.cc b/chrome/browser/ui/views/frame/vertical_tab_strip_region_view.cc
index f3ab4f166bc17..b0836c94eced3 100644
--- a/chrome/browser/ui/views/frame/vertical_tab_strip_region_view.cc
+++ b/chrome/browser/ui/views/frame/vertical_tab_strip_region_view.cc
@@ -82,6 +82,7 @@
 #include "ui/views/view.h"
 #include "ui/views/view_class_properties.h"
 #include "ui/views/view_utils.h"
+#include "cromarc/hooks/hooks.h"  // Cromarc
 
 namespace {
 constexpr int kResizeAreaWidth = 5;
@@ -866,7 +867,11 @@ void VerticalTabStripRegionView::AddTabStripView(
   std::optional<size_t> separator_index =
       content_parent->GetIndexOf(top_button_separator_);
   CHECK(separator_index.has_value());
-  content_parent->AddChildViewAt(std::move(view), separator_index.value() + 1);
+  // Cromarc: the sidebar takes the tab list's place.
+  cromarc::hooks::InstallSidebar(
+      content_parent,
+      content_parent->AddChildViewAt(std::move(view), separator_index.value() + 1),
+      browser_view()->browser());
 
   // Pre-set the animation values to the appropriate state.
   auto* const animation_controller =
