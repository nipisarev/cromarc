From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolay Pisarev <nipisarev@gmail.com>
Date: Sat, 24 Oct 2026 00:15:36 +0200
Subject: [PATCH] Cromarc H4: register Cromarc WebUIs and their interfaces

RegisterChromeWebUIConfigs() and the desktop WebUI interface broker call
into //cromarc, which registers chrome://cromarc-* pages and binds their
Mojo interfaces (TabStripService for the sidebar's window, Cromarc's own).

diff --git a/chrome/browser/chrome_browser_interface_binders_webui_parts_desktop.cc b/chrome/browser/chrome_browser_interface_binders_webui_parts_desktop.cc
index 28f49b378fec8..adf44d52fafb0 100644
--- a/chrome/browser/chrome_browser_interface_binders_webui_parts_desktop.cc
+++ b/chrome/browser/chrome_browser_interface_binders_webui_parts_desktop.cc
@@ -186,6 +186,8 @@
 #include "chrome/browser/ui/webui/feature_showcase/feature_showcase_ui.h"
 #endif
 
+#include "cromarc/hooks/hooks.h"  // Cromarc
+
 namespace chrome::internal {
 
 using content::RegisterWebUIControllerInterfaceBinder;
@@ -619,6 +621,8 @@ void PopulateChromeWebUIFrameInterfaceBrokersTrustedPartsDesktop(
                CustomizeColorSchemeModeHandlerFactory>()
       .Add<help_bubble::mojom::HelpBubbleHandlerFactory>();
 
+  cromarc::hooks::PopulateWebUIInterfaceBrokers(registry);  // Cromarc
+
   if (webui_browser::IsWebUIBrowserEnabled()) {
     registry.ForWebUI<WebUIBrowserUI>()
         .Add<webui_browser::mojom::PageHandlerFactory>()
diff --git a/chrome/browser/ui/webui/chrome_web_ui_configs.cc b/chrome/browser/ui/webui/chrome_web_ui_configs.cc
index d79e9dfdb0e67..f1fc699cc4ed9 100644
--- a/chrome/browser/ui/webui/chrome_web_ui_configs.cc
+++ b/chrome/browser/ui/webui/chrome_web_ui_configs.cc
@@ -251,6 +251,8 @@
 #endif  // BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC) || BUILDFLAG(IS_LINUX) || \
         // BUILDFLAG(IS_CHROMEOS)
 
+#include "cromarc/hooks/hooks.h"  // Cromarc
+
 void RegisterChromeWebUIConfigs() {
   // Don't add calls to `AddWebUIConfig()` for Ash-specific WebUIs here. Add
   // them to `AshWebUIConfigManager::RegisterWebUIConfigs()` in
@@ -398,6 +400,7 @@ void RegisterChromeWebUIConfigs() {
   map.AddWebUIConfig(std::make_unique<NewTabUIConfig>());
   map.AddWebUIConfig(std::make_unique<OmniboxEverywhereUIConfig>());
   map.AddWebUIConfig(std::make_unique<OmniboxPopupUIConfig>());
+  cromarc::hooks::RegisterWebUIConfigs(map);  // Cromarc
   map.AddWebUIConfig(std::make_unique<OrganizerPanelUIConfig>());
   map.AddWebUIConfig(
       std::make_unique<on_device_internals::OnDeviceInternalsUIConfig>());
