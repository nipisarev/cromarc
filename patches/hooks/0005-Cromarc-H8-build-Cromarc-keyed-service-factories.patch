From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolay Pisarev <nipisarev@gmail.com>
Date: Sat, 24 Oct 2026 01:16:25 +0200
Subject: [PATCH] Cromarc H8: build Cromarc keyed service factories

Chromium wants every keyed service factory built before the first profile;
EnsureBrowserContextKeyedServiceFactoriesBuilt() lets //cromarc build its
own (the tree service now, more in later parts).

diff --git a/chrome/browser/profiles/chrome_browser_main_extra_parts_profiles.cc b/chrome/browser/profiles/chrome_browser_main_extra_parts_profiles.cc
index a281709c54cd7..eaa41472cf616 100644
--- a/chrome/browser/profiles/chrome_browser_main_extra_parts_profiles.cc
+++ b/chrome/browser/profiles/chrome_browser_main_extra_parts_profiles.cc
@@ -654,6 +654,8 @@
 #include "chrome/browser/net/nss_service_factory.h"
 #endif
 
+#include "cromarc/hooks/hooks.h"  // Cromarc
+
 void AddProfilesExtraParts(ChromeBrowserMainParts* main_parts) {
   main_parts->AddParts(std::make_unique<ChromeBrowserMainExtraPartsProfiles>());
 }
@@ -1576,6 +1578,7 @@ void ChromeBrowserMainExtraPartsProfiles::
 
   WebDataServiceFactory::GetInstance();
   webrtc_event_logging::WebRtcEventLogManagerKeyedServiceFactory::GetInstance();
+  cromarc::hooks::EnsureKeyedServiceFactoriesBuilt();  // Cromarc
 }
 
 void ChromeBrowserMainExtraPartsProfiles::PreProfileInit() {
