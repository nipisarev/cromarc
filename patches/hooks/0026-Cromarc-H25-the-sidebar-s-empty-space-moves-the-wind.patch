@@ -330,6 +330,11 @@ bool VerticalTabStripRegionView::IsPositionInWindowCaption(
     return bottom_button_container_->IsPositionInWindowCaption(point_in_child);
   }
 
+  // Cromarc: the sidebar's own empty space moves the window, as Zen's does.
+  if (cromarc::hooks::IsSidebarCaption(browser_view()->browser(), this, point)) {
+    return true;
+  }
+
   // For any of the other children, absorb the click as non window caption.
   for (views::View* child : children()) {
     if (child == content_area_view_) {
