From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolay Pisarev <nipisarev@gmail.com>
Date: Sun, 25 Oct 2026 20:24:30 +0100
Subject: [PATCH] Cromarc H17: the compact sidebar blurs what it floats over

CustomCornersBackground::SetUseBackgroundBlur() asks Cromarc first: the
sidebar out over the page in compact mode is acrylic, as Zen's with
zen.theme.acrylic-sidebar, and Cromarc gives its layer that blur.

diff --git a/chrome/browser/ui/views/frame/custom_corners_background.cc b/chrome/browser/ui/views/frame/custom_corners_background.cc
index 41725c07e5b06..86f7d42dce543 100644
--- a/chrome/browser/ui/views/frame/custom_corners_background.cc
+++ b/chrome/browser/ui/views/frame/custom_corners_background.cc
@@ -159,6 +159,12 @@ void CustomCornersBackground::SetUseBackgroundBlur(bool use_background_blur) {
   }
   auto* const layer = view_->layer();
   CHECK(!layer->fills_bounds_opaquely());
+  // Cromarc: the sidebar floating in compact mode blurs what it is over.
+  if (cromarc::hooks::SetChromeBackgroundBlur(
+          &*view_, &browser_view(), layer,
+          GetBackgroundPath(view_->GetLocalBounds()))) {
+    return SchedulePaintHost();
+  }
   const float blur_radius = use_background_blur ? kBackgroundBlurRadius : 0.0f;
   const std::optional<gfx::Rect> local_bounds =
       use_background_blur ? std::make_optional(view_->GetLocalBounds())
