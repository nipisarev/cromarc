From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolay Pisarev <nipisarev@gmail.com>
Date: Sun, 25 Oct 2026 11:42:18 +0100
Subject: [PATCH] Cromarc H16: the Library takes the sidebar column while it is
 out

Zen's Library is at least 418px wide and moves the page aside as it
slides out; the vertical tab strip region asks Cromarc for its width.

diff --git a/chrome/browser/ui/views/frame/vertical_tab_strip_region_view.cc b/chrome/browser/ui/views/frame/vertical_tab_strip_region_view.cc
index b0836c94eced3..cd4e66feecca3 100644
--- a/chrome/browser/ui/views/frame/vertical_tab_strip_region_view.cc
+++ b/chrome/browser/ui/views/frame/vertical_tab_strip_region_view.cc
@@ -540,6 +540,8 @@ gfx::Size VerticalTabStripRegionView::CalculatePreferredSize(
                  (motion == TabStripAnimations::kExpand
                       ? std::floor<double>
                       : std::ceil<double>)(expand_amount * expand_percent));
+  // Cromarc: the Library takes the column while it is out.
+  size = cromarc::hooks::RegionSize(browser_view()->browser(), size);
   return size;
 }
 
