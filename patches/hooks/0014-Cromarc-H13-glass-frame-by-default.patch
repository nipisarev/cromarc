From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolay Pisarev <nipisarev@gmail.com>
Date: Sun, 25 Oct 2026 00:02:25 +0200
Subject: [PATCH] Cromarc H13: glass frame by default

Zen gives its macOS window a translucent, blurred backdrop
(zen.widget.macos.window-vibrancy). Chrome's glass frame does the same
behind the vertical tab strip region, where the Cromarc sidebar lives, on
macOS 26 and later; Cromarc turns it on.

diff --git a/ui/base/ui_base_features.cc b/ui/base/ui_base_features.cc
index 75d95b11bbc67..f3adf9e138c62 100644
--- a/ui/base/ui_base_features.cc
+++ b/ui/base/ui_base_features.cc
@@ -10,6 +10,7 @@
 #include "base/feature_list.h"
 #include "base/metrics/field_trial_params.h"
 #include "build/build_config.h"
+#include "cromarc/hooks/hooks.h"  // Cromarc
 
 #if BUILDFLAG(IS_ANDROID)
 #include "base/android/android_info.h"
@@ -500,7 +501,10 @@ BASE_FEATURE_PARAM(int,
 
 BASE_FEATURE(kDesktopGlowUp, base::FEATURE_DISABLED_BY_DEFAULT);
 
-BASE_FEATURE(kGlassFrame, base::FEATURE_DISABLED_BY_DEFAULT);
+// Cromarc: the sidebar on a translucent window, as Zen's macOS window
+// vibrancy (zen.widget.macos.window-vibrancy).
+BASE_FEATURE(kGlassFrame,
+             cromarc::hooks::GlassFrameDefault(base::FEATURE_DISABLED_BY_DEFAULT));
 BASE_FEATURE_PARAM(bool, kGlassExpandOnHoverEnabled, &kGlassFrame, true);
 
 BASE_FEATURE(kRoundedIcons, base::FEATURE_DISABLED_BY_DEFAULT);
