From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolay Pisarev <nipisarev@gmail.com>
Date: Sat, 24 Oct 2026 00:14:25 +0200
Subject: [PATCH] Cromarc H1: vertical tabs by default

The Cromarc sidebar is hosted in the vertical tab strip region, so new
profiles start in that mode.

diff --git a/chrome/browser/ui/tabs/tab_strip_prefs.cc b/chrome/browser/ui/tabs/tab_strip_prefs.cc
index 9a855747c23c7..1240eae49ccd4 100644
--- a/chrome/browser/ui/tabs/tab_strip_prefs.cc
+++ b/chrome/browser/ui/tabs/tab_strip_prefs.cc
@@ -17,6 +17,7 @@
 #include "components/pref_registry/pref_registry_syncable.h"
 #include "components/prefs/pref_service.h"
 #include "ui/actions/actions.h"
+#include "cromarc/hooks/hooks.h"  // Cromarc
 
 namespace tabs {
 
@@ -25,7 +26,9 @@ void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
   registry->RegisterBooleanPref(prefs::kOrganizerPanelPinnedToTabstrip, true);
   registry->RegisterBooleanPref(prefs::kEverythingMenuPinnedToTabstrip, true);
   registry->RegisterBooleanPref(prefs::kTabScrollButtonsPinnedToTabstrip, true);
-  registry->RegisterBooleanPref(prefs::kVerticalTabsEnabled, false);
+  // Cromarc: the sidebar lives in the vertical tab strip region.
+  registry->RegisterBooleanPref(prefs::kVerticalTabsEnabled,
+                                cromarc::hooks::VerticalTabsByDefault(false));
   registry->RegisterBooleanPref(prefs::kVerticalTabsExpandOnHoverEnabled, true);
   registry->RegisterBooleanPref(prefs::kVerticalTabsEnabledFirstTime, false);
   registry->RegisterBooleanPref(prefs::kVerticalTabsCollapsedState, false);
