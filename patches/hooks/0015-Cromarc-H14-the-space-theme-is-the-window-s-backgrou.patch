From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolay Pisarev <nipisarev@gmail.com>
Date: Sun, 25 Oct 2026 02:09:32 +0200
Subject: [PATCH] Cromarc H14: the space theme is the window's background

Zen draws the space theme, its gradient and grain, under the whole window,
and the toolbar and the space round the page stay clear over it. In Cromarc
windows (normal ones, with the sidebar) the frame view paints the theme
through cromarc::PaintWindowBackground, over the glass or the frame colour;
the glass covers the whole window without Chrome's tint;
MultiContentsBackgroundView leaves its area clear; and
CustomCornersBackground (toolbar, top container, tab strip region) lets
Cromarc paint instead: nothing, but Zen's compact toolbar background for the
sidebar floating over the page.

diff --git a/chrome/browser/ui/views/frame/browser_frame_view_mac.mm b/chrome/browser/ui/views/frame/browser_frame_view_mac.mm
index 09c735790df77..0e49ef22bfe75 100644
--- a/chrome/browser/ui/views/frame/browser_frame_view_mac.mm
+++ b/chrome/browser/ui/views/frame/browser_frame_view_mac.mm
@@ -66,6 +66,7 @@
 #include "ui/views/controls/label.h"
 #include "ui/views/layout/layout_types.h"
 #include "ui/views/widget/widget.h"
+#include "cromarc/hooks/hooks.h"  // Cromarc
 
 namespace {
 
@@ -504,6 +505,9 @@ void BrowserFrameViewMac::OnPaint(gfx::Canvas* canvas) {
   if (is_glass_frame_eligible_) {
     // In glass mode, painting to frame color happens in the opaque background
     // view instead.
+    // Cromarc: the space theme over the glass.
+    cromarc::hooks::PaintWindowBackground(canvas, GetLocalBounds(),
+                                          GetBrowserView());
     return;
   }
 
@@ -516,6 +520,9 @@ void BrowserFrameViewMac::OnPaint(gfx::Canvas* canvas) {
   if (!theme_service->UsingSystemTheme()) {
     PaintThemedFrame(canvas);
   }
+  // Cromarc: the space theme over the frame colour.
+  cromarc::hooks::PaintWindowBackground(canvas, GetLocalBounds(),
+                                        GetBrowserView());
 }
 
 void BrowserFrameViewMac::Layout(PassKey) {
diff --git a/chrome/browser/ui/views/frame/browser_native_widget_mac.mm b/chrome/browser/ui/views/frame/browser_native_widget_mac.mm
index 73a8db26c25b7..bb64e6b1a1b90 100644
--- a/chrome/browser/ui/views/frame/browser_native_widget_mac.mm
+++ b/chrome/browser/ui/views/frame/browser_native_widget_mac.mm
@@ -77,6 +77,7 @@
 #include "ui/native_theme/native_theme.h"
 #import "ui/views/cocoa/native_widget_mac_ns_window_host.h"
 #include "ui/views/interaction/element_tracker_views.h"
+#include "cromarc/hooks/hooks.h"  // Cromarc
 
 namespace {
 
@@ -317,6 +318,10 @@ std::optional<int> BrowserNativeWidgetMac::GetGlassFrameHeight() const {
 }
 
 std::optional<int> BrowserNativeWidgetMac::GetGlassFrameWidth() const {
+  // Cromarc: glass under the whole window, as Zen's vibrancy.
+  if (cromarc::hooks::ThemesWindow(browser_view_)) {
+    return std::nullopt;
+  }
   // If vertical tabs are not being drawn (e.g. horizontal tab strip mode,
   // popup/app windows, or window too narrow to render vertical tabs), the glass
   // effect view spans the full window width without horizontal restriction.
@@ -1178,9 +1183,11 @@ void BrowserNativeWidgetMac::UpdateBackgroundColor() {
   last_is_vertical_tabs_ = is_vertical_tabs;
   has_multiple_profiles_open_ = are_multiple_profiles_open;
 
-  const double tint_opacity =
+  // Cromarc: the space theme is the tint.
+  const double tint_opacity = cromarc::hooks::GlassTint(
+      browser_view_,
       GetGlassFrameTintOpacity(color_utils::IsDark(theme_color),
-                               is_vertical_tabs, has_multiple_profiles_open_);
+                               is_vertical_tabs, has_multiple_profiles_open_));
 
   const CGFloat r = SkColorGetR(theme_color) / 255.0;
   const CGFloat g = SkColorGetG(theme_color) / 255.0;
diff --git a/chrome/browser/ui/views/frame/custom_corners_background.cc b/chrome/browser/ui/views/frame/custom_corners_background.cc
index bff97f7c0be49..41725c07e5b06 100644
--- a/chrome/browser/ui/views/frame/custom_corners_background.cc
+++ b/chrome/browser/ui/views/frame/custom_corners_background.cc
@@ -37,6 +37,7 @@
 #include "ui/views/view.h"
 #include "ui/views/view_utils.h"
 #include "ui/views/widget/widget.h"
+#include "cromarc/hooks/hooks.h"  // Cromarc
 
 namespace {
 // Radius of the corner blur used for the glass frame.
@@ -326,6 +327,12 @@ void CustomCornersBackground::Paint(gfx::Canvas* canvas,
   if (!visible_) {
     return;
   }
+  // Cromarc: the space theme under the window shows through, or Cromarc
+  // paints the floating sidebar.
+  if (cromarc::hooks::PaintChromeBackground(canvas, view, GetBackgroundPath(),
+                                            &browser_view())) {
+    return;
+  }
 
   if (view->layer()) {
     CHECK(!view->layer()->fills_bounds_opaquely());
diff --git a/chrome/browser/ui/views/frame/multi_contents_background_view.cc b/chrome/browser/ui/views/frame/multi_contents_background_view.cc
index 56e57faa10148..138c97afa4460 100644
--- a/chrome/browser/ui/views/frame/multi_contents_background_view.cc
+++ b/chrome/browser/ui/views/frame/multi_contents_background_view.cc
@@ -8,6 +8,7 @@
 #include "ui/base/metadata/metadata_impl_macros.h"
 #include "ui/compositor/layer_solid_color.h"
 #include "ui/gfx/geometry/rounded_corners_f.h"
+#include "cromarc/hooks/hooks.h"  // Cromarc
 
 MultiContentsBackgroundView::MultiContentsBackgroundView(
     BrowserView* browser_view)
@@ -43,6 +44,10 @@ void MultiContentsBackgroundView::OnThemeChanged() {
 
 void MultiContentsBackgroundView::OnPaint(gfx::Canvas* canvas) {
   CHECK(layer()->AsTextured());
+  // Cromarc: the space theme under the window shows through.
+  if (cromarc::hooks::ThemesWindow(browser_view_)) {
+    return;
+  }
   ThemedBackground::PaintBackground(canvas, this, browser_view_);
 }
 
@@ -54,6 +59,10 @@ ui::LayerType MultiContentsBackgroundView::CalculateLayerType() const {
 
 void MultiContentsBackgroundView::UpdateSolidLayerColor() {
   CHECK(layer()->AsSolidColor());
+  // Cromarc: the space theme under the window shows through.
+  if (cromarc::hooks::ClearSolidLayer(layer(), browser_view_)) {
+    return;
+  }
   if (auto color = ThemedBackground::GetBackgroundColor(this, browser_view_)) {
     layer()->AsSolidColor()->SetColor(SkColor4f::FromColor(*color));
   }
