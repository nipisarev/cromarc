@@ -76,6 +76,7 @@
 #include "ui/native_theme/native_theme.h"
 #import "ui/views/cocoa/native_widget_mac_ns_window_host.h"
 #include "ui/views/interaction/element_tracker_views.h"
+#include "cromarc/hooks/hooks.h"  // Cromarc
 
 namespace {
 
@@ -1023,6 +1024,10 @@ void BrowserNativeWidgetMac::UpdateGlassEligibility(bool is_glass_eligible) {
                                       colorWithAlphaComponent:0.001]];
 
     if (!glass_background_view_) {
+      // Cromarc: Zen's window material under a space window instead.
+      if (cromarc::hooks::InstallWindowMaterial(browser_view_)) {
+        return;
+      }
       NSView* const content_view = [ns_window contentView];
 
       NSGlassEffectView* const glass_view =
diff --git a/chrome/browser/ui/views/frame/custom_corners_background.cc b/chrome/browser/ui/views/frame/custom_corners_background.cc
index 824f76b00e3d0..1c44a3d813da9 100644
--- a/chrome/browser/ui/views/frame/custom_corners_background.cc
+++ b/chrome/browser/ui/views/frame/custom_corners_background.cc
@@ -36,6 +36,7 @@
 #include "ui/views/view.h"
 #include "ui/views/view_utils.h"
 #include "ui/views/widget/widget.h"
+#include "cromarc/hooks/hooks.h"  // Cromarc
 
 namespace {
 // Radius of the corner blur used for the glass frame.
@@ -313,6 +314,12 @@ void CustomCornersBackground::Paint(gfx::Canvas* canvas,
   if (!visible_) {
     return;
   }
+  // Cromarc: the space theme under the window shows through, or Cromarc
+  // paints the floating sidebar.
+  if (cromarc::hooks::PaintChromeBackground(canvas, view, GetBackgroundPath(),
+                                            &browser_view())) {
+    return;
+  }
 
   if (view->layer()) {
     CHECK(!view->layer()->fills_bounds_opaquely());
diff --git a/chrome/browser/ui/views/frame/multi_contents_background_view.cc b/chrome/browser/ui/views/frame/multi_contents_background_view.cc
index 56e57faa10148..138c97afa4460 100644
--- a/chrome/browser/ui/views/frame/multi_contents_background_view.cc
+++ b/chrome/browser/ui/views/frame/multi_contents_background_view.cc
@@ -8,6 +8,7 @@
 #include "ui/base/metadata/metadata_impl_macros.h"
 #include "ui/compositor/layer_solid_color.h"
 #include "ui/gfx/geometry/rounded_corners_f.h"
+#include "cromarc/hooks/hooks.h"  // Cromarc
 
 MultiContentsBackgroundView::MultiContentsBackgroundView(
     BrowserView* browser_view)
@@ -43,6 +44,10 @@ void MultiContentsBackgroundView::OnThemeChanged() {
 
 void MultiContentsBackgroundView::OnPaint(gfx::Canvas* canvas) {
   CHECK(layer()->AsTextured());
+  // Cromarc: the space theme under the window shows through.
+  if (cromarc::hooks::ThemesWindow(browser_view_)) {
+    return;
+  }
   ThemedBackground::PaintBackground(canvas, this, browser_view_);
 }
 
@@ -54,6 +59,10 @@ ui::LayerType MultiContentsBackgroundView::CalculateLayerType() const {
 
 void MultiContentsBackgroundView::UpdateSolidLayerColor() {
   CHECK(layer()->AsSolidColor());
+  // Cromarc: the space theme under the window shows through.
+  if (cromarc::hooks::ClearSolidLayer(layer(), browser_view_)) {
+    return;
+  }
   if (auto color = ThemedBackground::GetBackgroundColor(this, browser_view_)) {
     layer()->AsSolidColor()->SetColor(SkColor4f::FromColor(*color));
   }
