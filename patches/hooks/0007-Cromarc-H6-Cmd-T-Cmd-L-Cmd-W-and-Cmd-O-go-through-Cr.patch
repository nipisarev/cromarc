From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolay Pisarev <nipisarev@gmail.com>
Date: Sat, 24 Oct 2026 01:56:33 +0200
Subject: [PATCH] Cromarc H6: Cmd+T, Cmd+L, Cmd+W and Cmd+O go through Cromarc
 first


diff --git a/chrome/browser/ui/browser_command_controller.cc b/chrome/browser/ui/browser_command_controller.cc
index 921461b9e9bd0..26739ed72019c 100644
--- a/chrome/browser/ui/browser_command_controller.cc
+++ b/chrome/browser/ui/browser_command_controller.cc
@@ -200,6 +200,8 @@
 
 static_assert(BUILDFLAG(ENABLE_EXTENSIONS));
 
+#include "cromarc/hooks/hooks.h"  // Cromarc
+
 using Extension = extensions::Extension;
 using ExtensionRegistry = extensions::ExtensionRegistry;
 using ExtensionRegistryObserver = extensions::ExtensionRegistryObserver;
@@ -753,6 +755,9 @@ void BrowserCommandController::HandleCommandWithDisposition(
       CloseWindow(browser_);
       break;
     case IDC_NEW_TAB: {
+      if (cromarc::hooks::ShowCommandBar(browser_, false)) {  // Cromarc
+        break;
+      }
       NewTab(browser_, NewTabTypes::kNewTabCommand);
       break;
     }
@@ -762,6 +767,9 @@ void BrowserCommandController::HandleCommandWithDisposition(
     }
     case IDC_CLOSE_TAB:
       base::RecordAction(base::UserMetricsAction("CloseTabByKey"));
+      if (cromarc::hooks::KeepWindowOnLastTabClose(browser_)) {  // Cromarc
+        break;
+      }
       CloseTab(browser_);
       break;
     case IDC_SELECT_NEXT_TAB:
@@ -1102,6 +1110,9 @@ void BrowserCommandController::HandleCommandWithDisposition(
       FocusToolbar(browser_);
       break;
     case IDC_FOCUS_LOCATION:
+      if (cromarc::hooks::ShowCommandBar(browser_, true)) {  // Cromarc
+        break;
+      }
       if (!window()->IsLocationBarVisible()) {
         break;
       }
@@ -1134,6 +1145,9 @@ void BrowserCommandController::HandleCommandWithDisposition(
 
     // Show various bits of UI
     case IDC_OPEN_FILE:
+      if (cromarc::hooks::OpenLittleInSpace(browser_)) {  // Cromarc
+        break;
+      }
       BrowserSelectFileDialogController::From(browser_)->OpenFile();
       break;
     case IDC_CREATE_SHORTCUT:
