From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolay Pisarev <nipisarev@gmail.com>
Date: Sun, 25 Oct 2026 20:58:30 +0100
Subject: [PATCH] Cromarc H18: the page is a card all round, under a clear
 bookmarks bar

The browser view's layout asks Cromarc for the page's corners (Chrome
rounds only the one under the vertical tab strip in glass mode); a page
that is a card has no line over it; the bookmarks bar's background lets
the space theme show; and the vertical tab strip's top row leaves no room
for a combo button that is hidden.

diff --git a/chrome/browser/ui/views/frame/layout/browser_view_tabbed_layout_impl.cc b/chrome/browser/ui/views/frame/layout/browser_view_tabbed_layout_impl.cc
index 389c6f8c6e667..789834916349a 100644
--- a/chrome/browser/ui/views/frame/layout/browser_view_tabbed_layout_impl.cc
+++ b/chrome/browser/ui/views/frame/layout/browser_view_tabbed_layout_impl.cc
@@ -4,6 +4,8 @@
 
 #include "chrome/browser/ui/views/frame/layout/browser_view_tabbed_layout_impl.h"
 
+#include "cromarc/hooks/hooks.h"  // Cromarc
+
 #include <algorithm>
 #include <memory>
 #include <optional>
@@ -1258,6 +1260,9 @@ BrowserViewTabbedLayoutImpl::CalculateProposedLayout(
         content_corners.set_lower_left(radius);
       }
     }
+    // Cromarc: outside split view the page is a card, round all over.
+    content_corners = cromarc::hooks::PageCorners(views().browser_view.get(),
+                                                  content_corners);
     views().multi_contents_view->SetBackgroundRadii(content_corners);
   }
 
diff --git a/chrome/browser/ui/views/frame/multi_contents_view.cc b/chrome/browser/ui/views/frame/multi_contents_view.cc
index 24c529e00f18b..efc7ed9f3e620 100644
--- a/chrome/browser/ui/views/frame/multi_contents_view.cc
+++ b/chrome/browser/ui/views/frame/multi_contents_view.cc
@@ -848,6 +848,9 @@ void MultiContentsView::OnDragAndDropPrefStateChange() {
 }
 
 void MultiContentsView::SetShouldShowTopSeparator(bool should_show) {
+  // Cromarc: a page that is a card has no line over it.
+  should_show = cromarc::hooks::ShowsTopSeparator(browser_view_, IsInSplitView(),
+                                                  should_show);
   if (contents_separators_.should_show_top == should_show) {
     return;
   }
diff --git a/chrome/browser/ui/views/frame/themed_background.cc b/chrome/browser/ui/views/frame/themed_background.cc
index 169aee34fb385..940c4fb5d64d6 100644
--- a/chrome/browser/ui/views/frame/themed_background.cc
+++ b/chrome/browser/ui/views/frame/themed_background.cc
@@ -4,6 +4,8 @@
 
 #include "chrome/browser/ui/views/frame/themed_background.h"
 
+#include "cromarc/hooks/hooks.h"  // Cromarc
+
 #include <optional>
 
 #include "chrome/browser/themes/theme_properties.h"
@@ -52,6 +54,10 @@ ThemedBackground::ThemedBackground(BrowserView* browser_view,
     : browser_view_(browser_view), theme_choice_(theme_choice) {}
 
 void ThemedBackground::Paint(gfx::Canvas* canvas, views::View* view) const {
+  // Cromarc: the space theme shows through, as in Zen's toolbox.
+  if (cromarc::hooks::PaintsOnSpaceTheme(view, browser_view_)) {
+    return;
+  }
   PaintBackground(canvas, view, browser_view_, theme_choice_);
 }
 
diff --git a/chrome/browser/ui/views/tabs/vertical/vertical_tab_strip_top_container.cc b/chrome/browser/ui/views/tabs/vertical/vertical_tab_strip_top_container.cc
index d69e4dd30f732..bb8caa98795d0 100644
