import("//testing/test.gni")

assert(!is_android)

# Everything Cromarc links into Chrome. Hook H0 makes //chrome/browser/ui depend
# on this group, so a new module only needs a line here, not a patch upstream.
group("cromarc") {
  public_deps = [
    ":headers",
    "//cromarc/browser:keyed_services_impl",
    "//cromarc/browser/archive:service",
    "//cromarc/browser/chromium",
    "//cromarc/browser/lifecycle:service",
    "//cromarc/browser/spaces",
    "//cromarc/browser/tree:service",
    "//cromarc/browser/ui:browser_commands_impl",
    "//cromarc/browser/ui:webui_registration_impl",
    "//cromarc/browser/ui/arc_import:impl",
    "//cromarc/browser/ui/command_bar:impl",
    "//cromarc/browser/ui/sidebar:impl",
    "//cromarc/browser/ui/welcome:impl",
    "//cromarc/hooks:impl",
  ]
}

# Headers for the upstream files the hooks touch (no implementation, so no
# dependency cycle with //chrome/browser/ui).
group("headers") {
  public_deps = [
    "//cromarc/browser:keyed_services",
    "//cromarc/browser/ui:browser_commands",
    "//cromarc/browser/ui:webui_registration",
    "//cromarc/browser/ui/command_bar",
    "//cromarc/browser/ui/sidebar",
    "//cromarc/hooks",
  ]
}

test("cromarc_unittests") {
  deps = [
    "//components/test:run_all_unittests",
    "//cromarc/browser/arc_import:unit_tests",
    "//cromarc/browser/archive:unit_tests",
    "//cromarc/browser/chromium:unit_tests",
    "//cromarc/browser/lifecycle:unit_tests",
    "//cromarc/browser/routing:unit_tests",
    "//cromarc/browser/spaces:unit_tests",
    "//cromarc/browser/tree:unit_tests",
    "//cromarc/browser/ui/sidebar:unit_tests",
  ]
}
