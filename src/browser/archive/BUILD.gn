source_set("archive") {
  sources = [
    "archive.cc",
    "archive.h",
  ]
  public_deps = [
    "//base",
    "//sql",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "archive_unittest.cc" ]
  deps = [
    ":archive",
    "//base/test:test_support",
    "//testing/gtest",
    "//url",
  ]
}

