assert(!is_android)

# Hook H6's entry points.
source_set("browser_commands") {
  sources = [ "browser_commands.h" ]
  public_deps = [ "//url" ]
}

source_set("browser_commands_impl") {
  sources = [ "browser_commands.cc" ]
  public_deps = [ "//chrome/browser:browser_public_dependencies" ]
  deps = [
    "//cromarc/browser/ports",
    ":browser_commands",
    "//chrome/browser/profiles:profile",
    "//cromarc/browser/routing",
    "//cromarc/browser/spaces",
    "//cromarc/browser/ui/glance",
    "//cromarc/browser/ui/little",
  ]
}

source_set("webui_registration") {
  sources = [ "webui_registration.h" ]
}

source_set("webui_registration_impl") {
  sources = [ "webui_registration.cc" ]
  public_deps = [ "//chrome/browser:browser_public_dependencies" ]
  deps = [
    ":webui_registration",
    "//components/browser_apis/tab_strip:mojom",
    "//content/public/browser",
    "//cromarc/browser/ui/arc_import",
    "//cromarc/browser/ui/command_bar",
    "//cromarc/browser/ui/sidebar",
    "//cromarc/browser/ui/sidebar:mojo_bindings",
    "//cromarc/browser/ui/welcome",
  ]
}
