import("//mojo/public/tools/bindings/mojom.gni")

assert(!is_android)

mojom("mojo_bindings") {
  sources = [ "sidebar.mojom" ]
  webui_module_path = "/"
  public_deps = [
    "//components/browser_apis/tab_strip:mojom",
    "//url/mojom:url_mojom_gurl",
  ]
}

# Headers, for the upstream files the hooks touch. Split from :impl the way
# Chromium splits //chrome/browser/ui/webui/* so that //chrome/browser/ui can
# depend on it without a cycle.
source_set("sidebar") {
  sources = [
    "cromarc_sidebar.h",
    "sidebar_ui.h",
    "sidebar_view.h",
  ]
  public_deps = [
    ":mojo_bindings",
    "//chrome/browser/ui/webui/top_chrome",
    "//components/browser_apis/tab_strip:mojom",
    "//components/prefs",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//ui/base",
    "//ui/gfx/geometry",
    "//ui/views",
    "//ui/views/controls/webview",
  ]
}

source_set("impl") {
  sources = [
    "compact_mode.cc",
    "compact_mode.h",
    "cromarc_sidebar.cc",
    "library_backend.cc",
    "library_backend.h",
    "library_downloads.cc",
    "library_downloads.h",
    "library_media.cc",
    "library_media.h",
    "sidebar_page_handler.cc",
    "sidebar_page_handler.h",
    "sidebar_ui.cc",
    "sidebar_view.cc",
    "window_background.cc",
    "window_background.h",
    "haptic_feedback.h",
    "space_input.h",
  ]
  if (is_mac) {
    sources += [
      "haptic_feedback_mac.mm",
      "library_media_mac.mm",
      "space_input_mac.mm",
    ]
    frameworks = [
      "AppKit.framework",
      "Carbon.framework",
      "QuickLookThumbnailing.framework",
    ]
  }
  public_deps = [ "//chrome/browser:browser_public_dependencies" ]
  deps = [
    ":sidebar",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/tabs/tab_strip_api",
    "//chrome/browser/ui/webui:favicon_source",
    "//chrome/browser/ui/webui:webui_util",
    "//components/bookmarks/browser",
    "//chrome/browser:browser_process",
    "//chrome/browser:icon_manager",
    "//chrome/browser/download",
    "//chrome/browser/ui/webui:fileicon_source",
    "//components/download/content/public",
    "//components/download/public/common:public",
    "//components/history/core/browser",
    "//components/keyed_service/core",
    "//net",
    "//components/favicon_base",
    "//components/browser_apis/tab_strip/resources:resources",
    "//cromarc/browser/archive:service",
    "//cromarc/browser/lifecycle:service",
    "//cromarc/browser/routing",
    "//cromarc/browser/sync",
    "//cromarc/browser/spaces",
    "//cromarc/browser/tree:service",
    "//components/favicon/content",
    "//cromarc/browser/ui:browser_commands",
    "//cromarc/browser/ui/welcome",
    "//ui/base/mojom:ui_base_types",
    "//cc/paint",
    "//ui/color",
    "//ui/gfx",
    "//ui/gfx/codec",
    "//cromarc/webui:resources",
    "//skia",
    "//ui/menus",
    "//ui/views",
    "//ui/webui",
    "//url",
  ]
}
