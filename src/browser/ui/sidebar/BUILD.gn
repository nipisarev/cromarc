import("//mojo/public/tools/bindings/mojom.gni")

assert(!is_android)

mojom("mojo_bindings") {
  sources = [
    "sidebar.mojom",
    "theme_picker.mojom",
  ]
  webui_module_path = "/"
  public_deps = [
    "//components/browser_apis/tab_strip:mojom",
    "//url/mojom:url_mojom_gurl",
  ]
}

# Headers, for the upstream files the hooks touch. Split from :impl the way
# Chromium splits //chrome/browser/ui/webui/* so that //chrome/browser/ui can
# depend on it without a cycle.
source_set("sidebar") {
  sources = [
    "cromarc_sidebar.h",
    "sidebar_ui.h",
    "sidebar_view.h",
    "theme_picker_ui.h",
  ]
  public_deps = [
    ":mojo_bindings",
    "//cromarc/browser/ports",
    "//chrome/browser/ui/webui/top_chrome",
    "//components/browser_apis/tab_strip:mojom",
    "//components/prefs",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//ui/base",
    "//ui/gfx/geometry",
    "//ui/views",
    "//ui/views/controls/webview",
  ]
}

source_set("impl") {
  sources = [
    "cromarc_sidebar.cc",
    "library_backend.cc",
    "library_backend.h",
    "library_media.cc",
    "library_media.h",
    "sidebar_page_handler.cc",
    "sidebar_page_handler.h",
    "sidebar_ui.cc",
    "sidebar_view.cc",
    "theme_picker.cc",
    "theme_picker.h",
    "theme_picker_page_handler.cc",
    "theme_picker_page_handler.h",
    "theme_picker_ui.cc",
    "haptic_feedback.h",
    "space_input.h",
  ]
  if (is_mac) {
    sources += [
      "haptic_feedback_mac.mm",
      "library_media_mac.mm",
      "space_input_mac.mm",
    ]
    frameworks = [
      "AppKit.framework",
      "Carbon.framework",
      "QuickLookThumbnailing.framework",
    ]
  }
  public_deps = [ "//chrome/browser:browser_public_dependencies" ]
  deps = [
    ":compact_mode",
    ":sidebar",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/favicon",
    "//chrome/browser/ui/tabs/tab_strip_api",
    "//chrome/browser/ui/tabs/tab_strip_api/tab_strip_model_impl/converters",
    "//chrome/browser/ui/webui:favicon_source",
    "//chrome/browser/ui/webui:webui_util",
    "//components/bookmarks/browser",
    "//chrome/browser:browser_process",
    "//chrome/browser:icon_manager",
    "//chrome/browser/download",
    "//chrome/browser/ui/webui:fileicon_source",
    "//components/download/content/public",
    "//components/download/public/common:public",
    "//components/history/core/browser",
    "//components/keyed_service/core",
    "//net",
    "//components/favicon_base",
    "//components/browser_apis/tab_strip/resources:resources",
    "//cromarc/browser/archive:service",
    "//cromarc/browser/chromium:adapters",
    "//cromarc/browser/chromium:window_material",
    "//cromarc/browser/lifecycle:service",
    "//cromarc/browser/ui/glance:registry",
    "//cromarc/browser/routing",
    "//cromarc/browser/sync",
    "//cromarc/browser/spaces",
    "//cromarc/browser/tree:service",
    "//components/favicon/content",
    "//cromarc/browser/ui:browser_commands",
    "//cromarc/browser/ui:webui_strings",
    "//cromarc/browser/ui/welcome",
    "//ui/base/mojom:ui_base_types",
    "//cc/paint",
    "//ui/color",
    "//ui/gfx",
    "//ui/gfx/codec",
    "//cromarc/webui:resources",
    "//skia",
    "//ui/compositor",
    "//ui/menus",
    "//ui/views",
    "//ui/webui",
    "//url",
  ]
}

source_set("compact_mode") {
  sources = [
    "compact_mode.cc",
    "compact_mode.h",
  ]
  public_deps = [
    "//base",
    "//cromarc/browser/ports",
  ]
  deps = [
    ":compact_hover",
    ":navigation",
    "//ui/gfx/geometry",
    "//url",
  ]
}

# The space theme's painting, Zen's gradient and grain.
source_set("space_theme_painter") {
  sources = [
    "space_theme_painter.cc",
    "space_theme_painter.h",
  ]
  public_deps = [ "//skia" ]
  deps = [
    "//base",
    "//cc/paint",
    "//cromarc/webui:resources",
    "//ui/base",
    "//ui/gfx",
    "//ui/gfx/codec",
  ]
}

source_set("compact_hover") {
  sources = [
    "compact_hover.cc",
    "compact_hover.h",
  ]
  deps = [
    "//base",
    "//ui/gfx/geometry",
    "//url",
  ]
}

source_set("navigation") {
  sources = [
    "sidebar_navigation.cc",
    "sidebar_navigation.h",
  ]
  public_deps = [ ":mojo_bindings" ]
  deps = [
    "//base",
    "//content/public/browser",
    "//cromarc/browser/ports",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "compact_hover_unittest.cc",
    "compact_mode_unittest.cc",
    "sidebar_navigation_unittest.cc",
    "space_theme_painter_unittest.cc",
  ]
  deps = [
    ":compact_hover",
    ":compact_mode",
    ":navigation",
    ":space_theme_painter",
    "//base",
    "//base/test:test_support",
    "//cromarc/browser/ports:test_support",
    "//testing/gtest",
    "//ui/gfx/geometry",
    "//url",
  ]
}
