module cromarc.mojom;

import "components/browser_apis/tab_strip/tab_strip_api_data_model.mojom";
import "components/browser_apis/tab_strip/tab_strip_api_types.mojom";
import "url/mojom/url.mojom";

// A tab Cromarc closed, as the Library's archive lists it.
struct ArchivedTab {
  int64 id;
  url.mojom.Url url;
  string title;
  // When it was closed, in milliseconds since the Unix epoch.
  double closed_at;
  // "idle", "clear", "folder" or "little".
  string reason;
  string folder_path;
};

// A rule sending links from other apps to a space (Zen's space routing).
// A page in the Library's history (zen:library/sections/
// ZenLibraryHistorySection.mjs).
struct HistoryVisit {
  url.mojom.Url url;
  string title;
  // Its visit, the last one where a page shows once, in milliseconds since
  // the Unix epoch.
  double time;
  int32 visit_count;
};

// The history filter's sorts: by date a page shows once a day, otherwise
// once.
enum HistorySort {
  kDate,
  kSite,
  kMostVisited,
  kLastVisited,
};

enum DownloadState {
  kInProgress,
  kComplete,
  kCancelled,
  kInterrupted,
};

// A download as the Library and the download stack show it
// (zen:library/sections/ZenLibraryDownloadsSection.mjs,
// ZenLibraryWidget.sys.mjs).
struct Download {
  uint32 id;
  string file_name;
  // Where the file is, or is going; "" until a name is chosen.
  string path;
  url.mojom.Url url;
  DownloadState state;
  bool paused;
  // The finished file is gone from where it was put.
  bool missing;
  // Held back as dangerous until the user decides.
  bool dangerous;
  bool can_resume;
  bool open_when_complete;
  int64 received_bytes;
  // -1 while the size is not known.
  int64 total_bytes;
  // Bytes a second while it comes in.
  int64 speed;
  // Seconds left, -1 while not known.
  int64 time_left;
  // In milliseconds since the Unix epoch; end_time 0 until it ends.
  double start_time;
  double end_time;
  // The finished file itself as a picture, under this page, or "".
  string preview_url;
};

// What a row of the Library's downloads, or of the download stack, does.
enum DownloadCommand {
  // A finished file opens; one still coming in opens when it is done, or
  // no longer.
  kOpen,
  kShow,
  kCancel,
  kPause,
  kResume,
  kRetry,
  // Out of the list, the file left where it is.
  kHide,
  kDeleteFile,
  kCopyFile,
  kCopyLink,
  kKeepDangerous,
  kDiscardDangerous,
  // The file dragged out, onto the page or another app.
  kDrag,
};

// A picture or a video found for the Library's Media
// (zen:library/sections/ZenLibraryMediaSection.mjs). Its thumbnail is
// media-thumb/<id>.png under the page, a bigger one media-large/<id>.png,
// the file itself media-file/<id>.png or .mp4.
struct MediaItem {
  uint32 id;
  // The folder it was found under.
  string folder;
  string name;
  // "image" (the page draws it), "video", or "file" (a picture shown by
  // QuickLook's picture of it).
  string kind;
  // In milliseconds since the Unix epoch.
  double modified;
  int64 size;
  // In iCloud Drive and not on this Mac: it is not read.
  bool cloud_placeholder;
  // Small enough to be served whole; a bigger one opens in its app.
  bool served_whole;
};

enum MediaCommand {
  kOpen,
  kShow,
  kCopy,
};

struct LinkRoute {
  string id;
  string reference;
  // "contains", "equal-to" or "regex".
  string match;
  // The space's id.
  string space;
};

// A space found in iCloud Drive that this Mac does not have yet.
struct ICloudSpace {
  string uuid;
  string name;
  string icon;
};

// One node of the space's tree: a folder or a pinned item.
struct TreeNode {
  // Bookmark UUID. "" in calls means the tree root.
  string id;
  string title;
  bool is_folder;
  // Folders only.
  bool collapsed;
  // Pinned items only.
  bool essential;
  url.mojom.Url home_url;
  // The live tab of a pinned item; null while it sleeps.
  tabs_api.mojom.NodeId? tab;
  array<TreeNode> children;
};

// A glance (Zen's): a tab of the tab it was opened from. The sidebar does not
// list it; its parent's row or tile shows its favicon.
struct Glance {
  tabs_api.mojom.NodeId tab;
  tabs_api.mojom.NodeId parent;
};

// Lifecycle state of a tab worth showing: deferred, or about to be archived.
struct TabLifecycle {
  tabs_api.mojom.NodeId tab;
  // Would have been closed but could lose typed input ("Needs attention").
  bool deferred;
  // Minutes until the archive, within the last hour; 0 otherwise.
  int32 minutes_left;
};

// A space (= profile) as the switcher and the strips show it.
struct Space {
  // Profile directory base name.
  string id;
  string name;
  // Emoji or letter.
  string icon;
  // ARGB.
  uint32 color;
  // The space of this sidebar's window.
  bool current;
  // The theme editor's JSON, "" for none.
  string theme;
};

// A space's sidebar content as its own window's sidebar has it, for its
// strip in another window while switching and its card in the Library.
struct SpaceSnapshot {
  array<TreeNode> tree;
  // Its window's tabs, as the tab strip API gives them to that window's
  // sidebar.
  array<tabs_api.mojom.Tab> tabs;
  // Favicons of pinned items' home URLs, data: URLs from the space's own
  // profile: chrome://favicon2 asks the profile of the page showing it.
  map<string, string> favicons;
};

enum SwipeType {
  kStart,
  kUpdate,
  kEnd,
};

// From the trackpad tracker (CromarcSwipeTracker): kUpdate carries the
// cumulative amount, positive towards the next space; kEnd the direction,
// 1 next, -1 previous, 0 cancelled.
struct Swipe {
  SwipeType type;
  double amount;
  int32 direction;
};

// How far the active page's site can be trusted, for the address field's
// identity icon.
enum SiteSecurity {
  kNone,
  kSecure,
  kNotSecure,
  kBrowserPage,
};

// The active tab's navigation: Zen's back, forward and reload buttons and its
// address field (single toolbar).
struct Navigation {
  bool can_go_back;
  bool can_go_forward;
  bool loading;
  // What the field shows: the host, as Zen's
  // zen.urlbar.show-domain-only-in-sidebar does; the whole address when there
  // is none.
  string display;
  SiteSecurity security;
};

enum NavigationCommand {
  kBack,
  kForward,
  kReload,
  kStop,
};

interface PageHandlerFactory {
  CreatePageHandler(pending_remote<Page> page,
                    pending_receiver<PageHandler> handler);
};

// Tree operations of the sidebar of one window. Live tabs themselves (list,
// activate, close) go through TabStripService.
interface PageHandler {
  GetTree() => (array<TreeNode> nodes);

  // Focuses the live tab of a pinned item, or opens its home URL in this
  // window as a pinned tab.
  OpenItem(string id);
  CreateFolder(string parent_id, uint32 index, string title) => (string id);
  // Pins a live tab: a pinned item with the tab's URL as home URL.
  PinTab(tabs_api.mojom.NodeId tab, string parent_id, uint32 index,
         bool essential);
  MoveItem(string id, string parent_id, uint32 index);
  RenameItem(string id, string title);
  // A folder goes with its content; a pinned item's live tab stays open as an
  // ordinary (Today) tab.
  RemoveItem(string id);
  // The live tab goes back to the home URL, with only it in its history.
  ResetItem(string id);
  // Zen's Cmd+click on the reset button: the live tab's page moves to an
  // ordinary tab and the pinned tab resets.
  SeparateItem(string id);
  // The live tab's current URL becomes the home URL.
  SetHomeToCurrent(string id);
  SetCollapsed(string id, bool collapsed);
  SetEssential(string id, bool essential);
  // "+ New Tab".
  NewTab();
  // A native context menu at (x, y) in the page, as Zen's; an empty label is a
  // separator, one starting with a tab goes in a submenu of the label before
  // it, and \x01 in front checks it. Returns the chosen label's index, or -1.
  ShowContextMenu(array<string> labels, int32 x, int32 y) => (int32 index);
  // A trackpad tick, as Zen's when a drag changes its drop slot.
  PlayHapticFeedback();
  // Cmd+S from the menu: compact mode on or off.
  ToggleCompactMode();

  GetTabLifecycles() => (array<TabLifecycle> tabs);
  // The window's glances.
  GetGlances() => (array<Glance> glances);
  // "Keep" on a deferred tab: its clock restarts.
  KeepTab(tabs_api.mojom.NodeId tab);
  // Today's "Clear": archives and closes the Today tabs of this window.
  ClearToday() => (array<url.mojom.Url> closed);
  // Undo of Clear: reopens these URLs as Today tabs.
  ReopenTabs(array<url.mojom.Url> urls);

  GetSpaces() => (array<Space> spaces);
  // Null when the space's profile is not loaded.
  GetSpaceSnapshot(string id) => (SpaceSnapshot? snapshot);
  // End of the switch animation: the space's window takes this one's place.
  SwitchToSpace(string id);
  // The Library's Spaces (ZenLibrarySpacesSection): the space's window comes
  // up, with its pinned item `item_id` open, or else its tab at `url`.
  OpenSpaceEntry(string space_id, string item_id, url.mojom.Url url);
  // As a switch animation starts: the target space's window gets ready under
  // this one's, so the swap shows it painted; "" when it won't be needed.
  PrepareSpaceSwitch(string id);

  // Space settings (design, UI section 11). `icon`: an emoji, "icon:<name>"
  // for one of Zen's icons, or "" for none (Zen's no-icon).
  CreateSpace(string name, string icon);
  RenameSpace(string id, string name);
  SetSpaceIcon(string id, string icon);
  SetSpaceTheme(string id, string theme);
  // Zen's theme picker for space `id`, beside the sidebar.
  OpenThemePicker(string id);
  // While switching spaces, the window's background fades toward the other
  // space's `theme` by `progress` 0-1, as Zen's --zen-background-opacity.
  BlendSpaceTheme(string theme, float progress);
  ReorderSpaces(array<string> ids);
  // Closes the space's live tabs: Today's go to the archive, pinned ones
  // sleep.
  SleepSpace(string id);
  // False for the last space.
  DeleteSpace(string id) => (bool deleted);

  // The active tab's navigation; OnNavigationChanged follows it.
  GetNavigation() => (Navigation navigation);
  Navigate(NavigationCommand command);
  // Chromium's back or forward history under the button at (x, y) in the
  // page, on a long press or a right click.
  ShowNavigationHistory(bool forward, int32 x, int32 y);
  // The address field was clicked: the command bar on the page's address, as
  // Cmd+L.
  EditAddress();
  // The window's controls at the sidebar's top left, in DIPs: Zen's top row
  // leaves them room.
  GetWindowButtons() => (int32 width, int32 height);
  // Where the page leaves room at the end of the address field for the
  // window's extension buttons (Zen's single toolbar), in the page's
  // coordinates; an empty rectangle hides them. OnExtensionsWidthChanged
  // tells the width they take.
  PlaceExtensions(int32 x, int32 y, int32 width, int32 height);
  GetExtensionsWidth() => (int32 width);

  // As the Library slides out and back, the width the window's sidebar
  // column takes for it; 0 once it is shut.
  SetLibraryWidth(int32 width);
  // Chrome's row of top buttons above the sidebar and its padding below it,
  // in DIPs: the Library takes both while it is out, so the page holds the
  // sidebar still under it by as much.
  GetColumnInsets() => (int32 top, int32 bottom);

  // The Library's archive (design, UI section 10): this space's closed tabs
  // matching `query`, newest first.
  SearchArchive(string query, uint32 limit) => (array<ArchivedTab> tabs);
  // Back to Today: opens the URL and drops the archive row.
  RestoreFromArchive(int64 id, url.mojom.Url url, bool background);
  RemoveFromArchive(int64 id);

  // The Library's history: pages visited in the last `days_old` days that
  // match `query` (all of them for ""), newest first and at most `limit`, or
  // the most visited first.
  QueryHistory(string query, int32 days_old, uint32 limit, HistorySort sort)
      => (array<HistoryVisit> visits);
  ForgetPage(url.mojom.Url url);
  // What the site of `url` left behind: its pages in history, its cookies
  // and storage, its cache (Firefox's Forget About This Site).
  ForgetSite(url.mojom.Url url);
  // History since `begin`, in milliseconds since the Unix epoch; all of it
  // for 0.
  ClearHistory(double begin);
  // A page from the Library in a new tab of this window.
  OpenUrl(url.mojom.Url url, bool background);
  // The SVG of one of the Library's section sprites, which the page colours
  // itself (it cannot fetch its own resources).
  GetLibrarySprite(string name) => (string svg);

  // This profile's downloads, oldest first, as chrome://downloads lists them.
  GetDownloads() => (array<Download> downloads);
  DoDownload(uint32 id, DownloadCommand command);
  // The finished ones out of the list (Zen's "Clear all downloads").
  ClearDownloads();

  // Media in `folders` (Zen's named ones, or absolute paths): the folders
  // looked through, and what was found, newest first.
  ScanMedia(array<string> folders)
      => (array<string> roots, array<MediaItem> items);
  DoMedia(uint32 id, MediaCommand command);
  // The app the system opens it with, "" when it cannot tell.
  GetMediaOpener(uint32 id) => (string app);

  // The Library's link rules. `default_external` "" is the space used last.
  GetRoutes() => (array<LinkRoute> routes, string default_external);
  AddRoute(string reference, string match, string space);
  UpdateRoute(string id, string reference, string match, string space);
  RemoveRoute(string id);
  SetDefaultRoute(string space);

  // Sync through iCloud Drive (design, component 10). `enabled`: from the
  // next start; `active`: now.
  GetICloudSync(string space) => (bool enabled, bool active);
  SetICloudSync(string space, bool enabled);
  FindICloudSpaces() => (array<ICloudSpace> spaces);
  // A new space bound to one in iCloud Drive; it syncs after a restart.
  ConnectICloudSpace(ICloudSpace space);
  RestartBrowser();
};

interface Page {
  OnTreeChanged(array<TreeNode> nodes);
  OnTabLifecyclesChanged(array<TabLifecycle> tabs);
  OnGlancesChanged(array<Glance> glances);
  OnSpacesChanged(array<Space> spaces);
  // A hotkey or the wheel asked for `id`: animate, then SwitchToSpace().
  OnSwitchRequested(string id);
  OnSwipe(Swipe swipe);
  OnNavigationChanged(Navigation navigation);
  OnExtensionsWidthChanged(int32 width);
  // History or the archive changed while the Library may be showing them.
  OnHistoryChanged();
  // A download came, changed or went; at most four times a second.
  OnDownloadsChanged();
};
