module cromarc.mojom;

import "components/browser_apis/tab_strip/tab_strip_api_types.mojom";
import "url/mojom/url.mojom";

// A tab Cromarc closed, as the Library's archive lists it.
struct ArchivedTab {
  int64 id;
  url.mojom.Url url;
  string title;
  // When it was closed, in milliseconds since the Unix epoch.
  double closed_at;
  // "idle", "clear", "folder" or "little".
  string reason;
  string folder_path;
};

// One node of the space's tree: a folder or a pinned item.
struct TreeNode {
  // Bookmark UUID. "" in calls means the tree root.
  string id;
  string title;
  bool is_folder;
  // Folders only.
  bool collapsed;
  // Pinned items only.
  bool essential;
  url.mojom.Url home_url;
  // The live tab of a pinned item; null while it sleeps.
  tabs_api.mojom.NodeId? tab;
  array<TreeNode> children;
};

// Lifecycle state of a tab worth showing: deferred, or about to be archived.
struct TabLifecycle {
  tabs_api.mojom.NodeId tab;
  // Would have been closed but could lose typed input ("Needs attention").
  bool deferred;
  // Minutes until the archive, within the last hour; 0 otherwise.
  int32 minutes_left;
};

// A space (= profile) as the switcher and the strips show it.
struct Space {
  // Profile directory base name.
  string id;
  string name;
  // Emoji or letter.
  string icon;
  // ARGB.
  uint32 color;
  // The space of this sidebar's window.
  bool current;
};

struct SnapshotTab {
  string title;
  url.mojom.Url url;
  // data: URL, or "" (the page then asks chrome://favicon2).
  string favicon;
};

// Another space's sidebar content, for its strip while switching.
struct SpaceSnapshot {
  array<TreeNode> tree;
  array<SnapshotTab> today;
};

enum SwipeType {
  kStart,
  kUpdate,
  kEnd,
};

// From the trackpad tracker (CromarcSwipeTracker): kUpdate carries the
// cumulative amount, positive towards the next space; kEnd the direction,
// 1 next, -1 previous, 0 cancelled.
struct Swipe {
  SwipeType type;
  double amount;
  int32 direction;
};

interface PageHandlerFactory {
  CreatePageHandler(pending_remote<Page> page,
                    pending_receiver<PageHandler> handler);
};

// Tree operations of the sidebar of one window. Live tabs themselves (list,
// activate, close) go through TabStripService.
interface PageHandler {
  GetTree() => (array<TreeNode> nodes);

  // Focuses the live tab of a pinned item, or opens its home URL in this
  // window as a pinned tab.
  OpenItem(string id);
  CreateFolder(string parent_id, uint32 index, string title) => (string id);
  // Pins a live tab: a pinned item with the tab's URL as home URL.
  PinTab(tabs_api.mojom.NodeId tab, string parent_id, uint32 index,
         bool essential);
  MoveItem(string id, string parent_id, uint32 index);
  RenameItem(string id, string title);
  // A folder goes with its content; a pinned item's live tab stays open as an
  // ordinary (Today) tab.
  RemoveItem(string id);
  // The live tab goes back to the home URL.
  ResetItem(string id);
  // The live tab's current URL becomes the home URL.
  SetHomeToCurrent(string id);
  SetCollapsed(string id, bool collapsed);
  SetEssential(string id, bool essential);
  // "+ New Tab".
  NewTab();
  // Cmd+S from the menu: compact mode on or off.
  ToggleCompactMode();

  GetTabLifecycles() => (array<TabLifecycle> tabs);
  // "Keep" on a deferred tab: its clock restarts.
  KeepTab(tabs_api.mojom.NodeId tab);
  // Today's "Clear": archives and closes the Today tabs of this window.
  ClearToday() => (array<url.mojom.Url> closed);
  // Undo of Clear: reopens these URLs as Today tabs.
  ReopenTabs(array<url.mojom.Url> urls);

  GetSpaces() => (array<Space> spaces);
  // Null when the space's profile is not loaded.
  GetSpaceSnapshot(string id) => (SpaceSnapshot? snapshot);
  // End of the switch animation: the space's window takes this one's place.
  SwitchToSpace(string id);

  // Space settings (design, UI section 11). `icon`: an emoji, "icon:<name>"
  // for one of Zen's icons, or "" for the name's first letter.
  CreateSpace(string name, string icon);
  RenameSpace(string id, string name);
  SetSpaceIcon(string id, string icon);
  ReorderSpaces(array<string> ids);
  // Closes the space's live tabs: Today's go to the archive, pinned ones
  // sleep.
  SleepSpace(string id);
  // False for the last space.
  DeleteSpace(string id) => (bool deleted);

  // The Library's archive (design, UI section 10): this space's closed tabs
  // matching `query`, newest first.
  SearchArchive(string query, uint32 limit) => (array<ArchivedTab> tabs);
  // Back to Today: opens the URL and drops the archive row.
  RestoreFromArchive(int64 id, url.mojom.Url url);
};

interface Page {
  OnTreeChanged(array<TreeNode> nodes);
  OnTabLifecyclesChanged(array<TabLifecycle> tabs);
  OnSpacesChanged(array<Space> spaces);
  // A hotkey or the wheel asked for `id`: animate, then SwitchToSpace().
  OnSwitchRequested(string id);
  OnSwipe(Swipe swipe);
};
