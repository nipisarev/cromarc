# Cromarc's interfaces to Chromium (AGENTS.md, "Layers"). Feature code depends
# on these; //cromarc/browser/chromium implements them.
source_set("ports") {
  sources = [
    "app_lifecycle.h",
    "browser_frame.h",
    "tab_strip_api.h",
    "tabs.h",
    "vertical_strip.h",
    "windows.h",
  ]
  public_deps = [
    "//base",
    "//ui/gfx/geometry",
  ]
}

# Fakes of the ports for unit tests.
source_set("test_support") {
  testonly = true
  sources = [
    "fake_browser_frame.cc",
    "fake_browser_frame.h",
    "fake_tabs.cc",
    "fake_tabs.h",
    "fake_vertical_strip.cc",
    "fake_vertical_strip.h",
    "fake_windows.cc",
    "fake_windows.h",
  ]
  public_deps = [
    ":ports",
    "//url",
  ]
}
