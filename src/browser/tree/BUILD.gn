source_set("unit_tests") {
  testonly = true
  sources = [ "tree_service_unittest.cc" ]
  deps = [
    ":tree_service",
    "//cromarc/browser/ports:test_support",
    "//testing/gtest",
    "//url",
  ]
}

# The per-profile service (KeyedService) around Tree.
source_set("tree_service") {
  sources = [
    "tree_service.cc",
    "tree_service.h",
  ]
  public_deps = [
    "//components/keyed_service/core",
    "//cromarc/browser/ports",
  ]
  deps = [ "//url" ]
}

# Its factory, the composition root.
source_set("service") {
  sources = [
    "tree_service_factory.cc",
    "tree_service_factory.h",
  ]
  public_deps = [
    ":tree_service",
    "//chrome/browser:browser_public_dependencies",
  ]
  deps = [
    "//chrome/browser/bookmarks",
    "//chrome/browser/profiles:profile",
    "//cromarc/browser/chromium:adapters",
    "//cromarc/browser/chromium:bookmark_tree",
  ]
}
