# Zen's materials under a space window and a panel (AppKit only), for the
# hooks and for the theme picker.
source_set("window_material") {
  sources = [ "window_material.h" ]
  if (is_mac) {
    sources += [ "window_material_mac.mm" ]
    frameworks = [ "AppKit.framework" ]
  }
  public_deps = [ "//ui/gfx" ]
}

# The system's accent colour (AppKit only).
source_set("system_accent") {
  sources = [ "system_accent.h" ]
  if (is_mac) {
    sources += [ "system_accent_mac.mm" ]
    frameworks = [ "AppKit.framework" ]
  }
  public_deps = [ "//skia" ]
  deps = [ "//base" ]
}

# Tree in Chromium bookmarks.
source_set("bookmark_tree") {
  sources = [
    "bookmark_tree.cc",
    "bookmark_tree.h",
  ]
  public_deps = [
    "//components/bookmarks/browser",
    "//cromarc/browser/ports",
  ]
  deps = [
    "//base",
    "//components/bookmarks/common",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "bookmark_tree_unittest.cc" ]
  deps = [
    ":bookmark_tree",
    "//base/test:test_support",
    "//components/bookmarks/browser",
    "//components/bookmarks/common",
    "//components/bookmarks/test",
    "//cromarc/browser/ports:test_support",
    "//testing/gtest",
    "//url",
  ]
}
