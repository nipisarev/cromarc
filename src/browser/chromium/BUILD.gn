# Adapters: the ports (//cromarc/browser/ports) on Chromium's internals, the
# only feature-side code that includes them (AGENTS.md, "Layers").

# The process-wide ports, for the keyed service factories.
source_set("adapters") {
  sources = [
    "adapters.cc",
    "adapters.h",
    "app_lifecycle_adapter.cc",
    "app_lifecycle_adapter.h",
    "profiles_adapter.cc",
    "profiles_adapter.h",
    "strip_defaults_adapter.cc",
    "strip_defaults_adapter.h",
    "tab_strip_api_adapter.cc",
    "tab_strip_api_adapter.h",
    "tabs_adapter.cc",
    "tabs_adapter.h",
    "theme_adapter.cc",
    "theme_adapter.h",
    "windows_adapter.cc",
    "windows_adapter.h",
  ]
  public_deps = [
    "//chrome/browser:browser_public_dependencies",
    "//cromarc/browser/ports",
  ]
  deps = [
    "//chrome/browser:browser_process",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles:profile_manager",
    "//chrome/browser/themes",
    "//chrome/browser/ui/browser_window",
    "//chrome/common:constants",
    "//components/browser_apis/tab_strip/types",
    "//components/prefs",
    "//components/performance_manager",
    "//components/tabs:public",
    "//ui/base",
    "//url",
  ]
}

# A window's sidebar and its frame and strip.
source_set("chromium") {
  sources = [
    "browser_frame_adapter.cc",
    "browser_frame_adapter.h",
    "sidebar_installer.cc",
    "sidebar_installer.h",
    "space_controller_get.cc",
    "vertical_strip_adapter.cc",
    "vertical_strip_adapter.h",
  ]
  public_deps = [
    ":adapters",
    "//chrome/browser:browser_public_dependencies",
    "//cromarc/browser/ports",
  ]
  deps = [
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/browser_window",
    "//components/prefs",
    "//cromarc/browser/spaces",
    "//cromarc/browser/ui/sidebar",
    "//cromarc/browser/ui/sidebar:space_theme_painter",
    "//ui/color",
    "//ui/compositor",
    "//ui/gfx",
    "//ui/views",
  ]
}
