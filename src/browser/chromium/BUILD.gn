# Adapters: the ports (//cromarc/browser/ports) on Chromium's internals, the
# only feature-side code that includes them (AGENTS.md, "Layers").

# The process-wide ports, for the keyed service factories.
source_set("adapters") {
  sources = [
    "adapters.cc",
    "adapters.h",
    "app_lifecycle_adapter.cc",
    "app_lifecycle_adapter.h",
    "default_browser_adapter.cc",
    "default_browser_adapter.h",
    "favicons_adapter.cc",
    "favicons_adapter.h",
    "last_session_adapter.cc",
    "last_session_adapter.h",
    "local_sync_adapter.cc",
    "local_sync_adapter.h",
    "omnibox_adapter.cc",
    "omnibox_adapter.h",
    "presence_adapter.cc",
    "presence_adapter.h",
    "profiles_adapter.cc",
    "profiles_adapter.h",
    "strip_defaults_adapter.cc",
    "strip_defaults_adapter.h",
    "tab_strip_api_adapter.cc",
    "tab_strip_api_adapter.h",
    "tabs_adapter.cc",
    "tabs_adapter.h",
    "theme_adapter.cc",
    "theme_adapter.h",
    "windows_adapter.cc",
    "windows_adapter.h",
  ]
  public_deps = [
    "//chrome/browser:browser_public_dependencies",
    "//cromarc/browser/ports",
  ]
  deps = [
    "//chrome/browser:browser_process",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/prefs:util",
    "//chrome/browser/profiles:profile_manager",
    "//chrome/browser/sessions",
    "//chrome/browser/themes",
    "//chrome/browser/ui:browser_tabrestore",
    "//chrome/browser/ui/browser_window",
    "//chrome/common:constants",
    "//chrome/browser/favicon",
    "//chrome/browser/ui/tabs/tab_strip_api/tab_strip_model_impl/converters",
    "//components/browser_apis/tab_strip/types",
    "//components/favicon/core",
    "//components/favicon_base",
    "//chrome/browser/autocomplete",
    "//components/omnibox/browser",
    "//components/sessions",
    "//components/sync/base",
    "//components/sync/service",
    "//third_party/metrics_proto",
    "//components/prefs",
    "//components/performance_manager",
    "//components/tabs:public",
    "//content/public/browser",
    "//ui/base",
    "//ui/base/idle",
    "//url",
  ]
}

