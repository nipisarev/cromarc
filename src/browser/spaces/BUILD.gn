source_set("swipe_tracker") {
  sources = [
    "swipe_tracker.cc",
    "swipe_tracker.h",
  ]
  public_deps = [ "//base" ]
}

source_set("shared_sidebar_state") {
  sources = [
    "shared_sidebar_state.cc",
    "shared_sidebar_state.h",
  ]
  public_deps = [ "//base" ]
  deps = [ "//cromarc/browser/ports" ]
}

# The space controller (browser-process singleton) and per-space prefs.
source_set("spaces") {
  sources = [
    "space_controller.cc",
    "space_controller.h",
    "space_prefs.cc",
    "space_prefs.h",
    "space_window.h",
  ]
  if (is_mac) {
    sources += [ "space_window_mac.mm" ]
    frameworks = [ "AppKit.framework" ]
  }
  public_deps = [
    ":shared_sidebar_state",
    ":swipe_tracker",
    "//chrome/browser:browser_public_dependencies",
    "//components/sessions",
    "//skia",
  ]
  deps = [
    "//base:i18n",
    "//components/pref_registry",
    "//cromarc/browser/ports",
    "//components/prefs",
    "//ui/base",
    "//ui/gfx",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "shared_sidebar_state_unittest.cc",
    "swipe_tracker_unittest.cc",
  ]
  deps = [
    ":shared_sidebar_state",
    ":swipe_tracker",
    "//cromarc/browser/ports:test_support",
    "//testing/gtest",
  ]
}
