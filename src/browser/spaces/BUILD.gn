source_set("swipe_tracker") {
  sources = [
    "swipe_tracker.cc",
    "swipe_tracker.h",
  ]
  public_deps = [ "//base" ]
}

source_set("shared_sidebar_state") {
  sources = [
    "shared_sidebar_state.cc",
    "shared_sidebar_state.h",
  ]
  public_deps = [ "//base" ]
  deps = [ "//cromarc/browser/ports" ]
}

# The space controller: switching, warm windows and space settings, on the
# ports.
source_set("controller") {
  sources = [
    "space_controller.cc",
    "space_controller.h",
    "space_pref_names.cc",
    "space_pref_names.h",
    "space_window.h",
  ]
  if (is_mac) {
    sources += [ "space_window_mac.mm" ]
    frameworks = [ "AppKit.framework" ]
  }
  public_deps = [
    ":shared_sidebar_state",
    ":swipe_tracker",
    "//cromarc/browser/ports",
    "//skia",
    "//ui/gfx",
  ]
  deps = [
    "//base:i18n",
    "//components/prefs",
  ]
}

# The space prefs' registration, a keyed service factory.
source_set("spaces") {
  sources = [
    "space_prefs_factory.cc",
    "space_prefs_factory.h",
  ]
  public_deps = [
    ":controller",
    "//chrome/browser:browser_public_dependencies",
  ]
  deps = [
    "//chrome/browser/profiles:profile",
    "//components/pref_registry",
    "//components/prefs",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "shared_sidebar_state_unittest.cc",
    "space_controller_unittest.cc",
    "swipe_tracker_unittest.cc",
  ]
  deps = [
    ":controller",
    ":shared_sidebar_state",
    "//base/test:test_support",
    "//components/prefs:test_support",
    ":swipe_tracker",
    "//cromarc/browser/ports:test_support",
    "//testing/gtest",
  ]
}
