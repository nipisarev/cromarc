source_set("arc_import") {
  sources = [
    "arc_import.cc",
    "arc_import.h",
    "arc_sidebar.cc",
    "arc_sidebar.h",
  ]
  public_deps = [
    "//base",
    "//skia",
    "//url",
  ]
  deps = [
    "//base:i18n",
    "//cromarc/browser/ports",
    "//cromarc/strings:cromarc_strings",
