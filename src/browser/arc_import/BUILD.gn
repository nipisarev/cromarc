  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "arc_import_unittest.cc",
    "arc_sidebar_unittest.cc",
  ]
  deps = [
    ":arc_import",
    "//cromarc/browser/ports:test_support",
    "//testing/gtest",
  ]
}
