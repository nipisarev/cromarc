import("//cromarc/webui/sidebar/icons/icons.gni")
import("//ui/webui/resources/tools/build_webui.gni")

assert(!is_android)

# All Cromarc WebUI pages, one folder each, in a single package: hook H0 packs
# cromarc_resources.pak once and gives it one grit id range, so a new page
# needs no change upstream. Each page's data source serves the whole map with
# its own HTML as the default resource.
build_webui("build") {
  grd_prefix = "cromarc"

  static_files = [
    "arc_import/arc_import.html",
    "command_bar/command_bar.html",
    "sidebar/images/grain-bg.png",
    "sidebar/sidebar.html",
    "sidebar/library_icons/boosts.svg",
    "sidebar/library_icons/downloads.svg",
    "sidebar/library_icons/history.svg",
    "sidebar/library_icons/media.svg",
    "sidebar/library_icons/space-routing.svg",
    "sidebar/library_icons/spaces.svg",
    "sidebar/library_icons/tile.svg",
    "sidebar/ui_icons/add.svg",
    "sidebar/ui_icons/arrow-back.svg",
    "sidebar/ui_icons/arrow-undo.svg",
    "sidebar/ui_icons/brush.svg",
    "sidebar/ui_icons/chevron-down.svg",
    "sidebar/ui_icons/chevron.svg",
    "sidebar/ui_icons/clear.svg",
    "sidebar/ui_icons/close.svg",
    "sidebar/ui_icons/copy.svg",
    "sidebar/ui_icons/ellipsis.svg",
    "sidebar/ui_icons/eye-off.svg",
    "sidebar/ui_icons/folder-open.svg",
    "sidebar/ui_icons/library-sprite.svg",
    "sidebar/ui_icons/link.svg",
    "sidebar/ui_icons/menu.svg",
    "sidebar/ui_icons/open.svg",
    "sidebar/ui_icons/options.svg",
    "sidebar/ui_icons/refresh.svg",
    "sidebar/ui_icons/return-down-forward.svg",
    "sidebar/ui_icons/search.svg",
    "sidebar/ui_icons/trash.svg",
    "welcome/welcome.html",
  ] + cromarc_space_icons

  ts_files = [
    "arc_import/app.html.ts",
    "arc_import/app.ts",
    "arc_import/choices.ts",
    "command_bar/app.html.ts",
    "command_bar/app.ts",
    "sidebar/app.html.ts",
    "sidebar/app.ts",
    "sidebar/browser_proxy.ts",
    "sidebar/downloads_model.ts",
    "sidebar/downloads_store.ts",
    "sidebar/emoji_data.ts",
    "sidebar/folder_icon.html.ts",
    "sidebar/folder_icon.ts",
    "sidebar/icon_picker.html.ts",
    "sidebar/icon_picker.ts",
    "sidebar/library.html.ts",
    "sidebar/library.ts",
    "sidebar/library_downloads.html.ts",
    "sidebar/library_downloads.ts",
    "sidebar/library_filters.html.ts",
    "sidebar/library_filters.ts",
    "sidebar/library_history.html.ts",
    "sidebar/library_history.ts",
    "sidebar/library_model.ts",
    "sidebar/library_routing.html.ts",
    "sidebar/library_routing.ts",
    "sidebar/library_search.ts",
    "sidebar/library_search_box.html.ts",
    "sidebar/library_search_box.ts",
    "sidebar/library_sprites.ts",
    "sidebar/library_strings.ts",
    "sidebar/menu.ts",
    "sidebar/motion.ts",
    "sidebar/sidebar_model.ts",
    "sidebar/space_editor.html.ts",
    "sidebar/space_editor.ts",
    "sidebar/space_icon.ts",
    "sidebar/space_icons.ts",
    "sidebar/spaces.ts",
    "sidebar/strings.ts",
    "sidebar/tab_list_model.ts",
    "sidebar/theme_editor.html.ts",
    "sidebar/theme_editor.ts",
    "sidebar/theme_model.ts",
    "welcome/app.html.ts",
    "welcome/app.ts",
    "welcome/steps.ts",
  ]
  css_files = [
    "arc_import/app.css",
    "command_bar/app.css",
    "sidebar/app.css",
    "sidebar/folder_icon.css",
    "sidebar/icon_picker.css",
    "sidebar/library.css",
    "sidebar/space_editor.css",
    "sidebar/theme_editor.css",
    "welcome/app.css",
  ]

  webui_context_type = "trusted"

  ts_deps = [
    "//components/browser_apis/tab_strip/resources:build_ts",
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  # Generated bindings, served at the package root. sidebar.mojom imports
  # tabs_api types; like //chrome/browser/resources/webui_browser, the files
  # those reference are served at the root too.
  mojo_files_deps = [
    "//components/browser_apis/tab_strip:mojom_ts__copy_converters",
    "//components/browser_apis/tab_strip:mojom_ts__generator",
    "//cromarc/browser/ui/arc_import:mojo_bindings_ts__generator",
    "//cromarc/browser/ui/command_bar:mojo_bindings_ts__generator",
    "//cromarc/browser/ui/sidebar:mojo_bindings_ts__generator",
    "//cromarc/browser/ui/welcome:mojo_bindings_ts__generator",
  ]
  mojo_files = [
    "$root_gen_dir/components/browser_apis/tab_strip/node_id_converter.ts",
    "$root_gen_dir/components/browser_apis/tab_strip/tab_strip_api_types.mojom-converters.ts",
    "$root_gen_dir/components/browser_apis/tab_strip/tab_strip_api_types.mojom-webui.ts",
    "$root_gen_dir/cromarc/browser/ui/arc_import/arc_import.mojom-webui.ts",
    "$root_gen_dir/cromarc/browser/ui/command_bar/command_bar.mojom-webui.ts",
    "$root_gen_dir/cromarc/browser/ui/sidebar/sidebar.mojom-webui.ts",
    "$root_gen_dir/cromarc/browser/ui/welcome/welcome.mojom-webui.ts",
  ]

  ts_path_mappings = [ "/tab_strip_api/*|" + rebase_path(
                           "$root_gen_dir/components/browser_apis/tab_strip/resources/tsc/*",
                           target_gen_dir) ]
}
