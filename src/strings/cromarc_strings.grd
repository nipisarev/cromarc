      <message name="IDS_CROMARC_LIBRARY_SITE_OTHER" desc="The Library">Other</message>
      <message name="IDS_CROMARC_LIBRARY_HISTORY_SEARCH" desc="The Library">Search History…</message>
      <message name="IDS_CROMARC_LIBRARY_HISTORY_EMPTY" desc="The Library">No history found</message>
      <message name="IDS_CROMARC_LIBRARY_CLOSED_EMPTY" desc="The Library">No closed tabs</message>
      <message name="IDS_CROMARC_LIBRARY_FORGET_BUTTON" desc="The Library">Remove from history</message>
      <message name="IDS_CROMARC_LIBRARY_REOPEN_BUTTON" desc="The Library">Reopen page</message>
      <message name="IDS_CROMARC_LIBRARY_MENU_REOPEN" desc="The Library">Reopen Page</message>
      <message name="IDS_CROMARC_LIBRARY_MENU_FORGET" desc="The Library">Forget This Page</message>
      <message name="IDS_CROMARC_LIBRARY_MENU_FORGET_SITE" desc="The Library">Forget About This Site</message>
      <message name="IDS_CROMARC_LIBRARY_FORGET_SITE_TITLE" desc="The Library">Forget About This Site?</message>
      <message name="IDS_CROMARC_LIBRARY_FORGET_SITE_MESSAGE" desc="The Library">History, cookies, data and cache of <ph name="SITE">$1<ex>example.com</ex></ph> will be removed. This cannot be undone.</message>
      <message name="IDS_CROMARC_LIBRARY_FORGET_SITE_ACCEPT" desc="The Library">Forget</message>
      <message name="IDS_CROMARC_LIBRARY_ROUTING_SEARCH" desc="The Library">Search routes</message>
      <message name="IDS_CROMARC_LIBRARY_ROUTING_NEW" desc="The Library">New</message>
      <message name="IDS_CROMARC_LIBRARY_ROUTING_NEW_TITLE" desc="The Library">New route</message>
      <message name="IDS_CROMARC_LIBRARY_ROUTING_EDIT_TITLE" desc="The Library">Edit route</message>
