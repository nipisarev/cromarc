      <message name="IDS_CROMARC_LIBRARY_MENU_DELETE" desc="The Library">Delete File</message>
      <message name="IDS_CROMARC_LIBRARY_MENU_PAUSE" desc="The Library">Pause</message>
      <message name="IDS_CROMARC_LIBRARY_MENU_RESUME" desc="The Library">Resume</message>
      <message name="IDS_CROMARC_LIBRARY_MENU_GO_TO_PAGE" desc="The Library">Go To Download Page</message>
      <message name="IDS_CROMARC_LIBRARY_MENU_REMOVE_FROM_HISTORY" desc="The Library">Remove From History</message>
      <message name="IDS_CROMARC_LIBRARY_MENU_CLEAR_PREVIEW" desc="The Library">Clear Download Preview</message>
      <message name="IDS_CROMARC_LIBRARY_UNBLOCK_TITLE" desc="The Library">Keep this download?</message>
      <message name="IDS_CROMARC_LIBRARY_UNBLOCK_MESSAGE" desc="The Library">This file may harm your computer. Keep it only if you trust its source.</message>
      <message name="IDS_CROMARC_LIBRARY_UNBLOCK_ACCEPT" desc="The Library">Keep File</message>
      <message name="IDS_CROMARC_LIBRARY_SPACE_THEME" desc="The Library">Change theme</message>
      <message name="IDS_CROMARC_LIBRARY_SPACE_MOVE" desc="The Library">Drag to reorder</message>
      <message name="IDS_CROMARC_LIBRARY_SPACE_ICON" desc="The Library">Change icon</message>
      <message name="IDS_CROMARC_LIBRARY_SPACE_RENAME" desc="The Library">Rename space</message>
      <message name="IDS_CROMARC_LIBRARY_MEDIA_EMPTY" desc="The Library">No media found</message>
      <message name="IDS_CROMARC_LIBRARY_MEDIA_TURN_OFF" desc="The Library">Turn off Media</message>
      <message name="IDS_CROMARC_LIBRARY_MEDIA_SEARCH" desc="The Library">Search Media…</message>
      <message name="IDS_CROMARC_LIBRARY_MEDIA_LOADING" desc="The Library">Looking for media…</message>
      <message name="IDS_CROMARC_LIBRARY_MEDIA_OPT_IN_TITLE" desc="The Library">Your Media in the Library</message>
      <message name="IDS_CROMARC_LIBRARY_MEDIA_OPT_IN_BODY" desc="The Library">Quickly grab screenshots, images and videos from your computer by showing them in the Cromarc Library.</message>
      <message name="IDS_CROMARC_LIBRARY_MEDIA_OPT_IN_BUTTON" desc="The Library">Show Media</message>
      <message name="IDS_CROMARC_LIBRARY_MEDIA_OPT_IN_NOTE" desc="The Library">Media never leaves your computer and is not viewable by anyone but you.</message>
      <message name="IDS_CROMARC_LIBRARY_MEDIA_FILTER_TITLE" desc="The Library">Filter Media…</message>
      <message name="IDS_CROMARC_LIBRARY_MEDIA_FILTER_FOLDERS" desc="The Library">Where to look</message>
      <message name="IDS_CROMARC_LIBRARY_MEDIA_OPEN_IN" desc="The Library">Open in <ph name="APP">$1<ex>Preview</ex></ph></message>
      <message name="IDS_CROMARC_LIBRARY_MEDIA_PREVIOUS" desc="The Library">Previous</message>
      <message name="IDS_CROMARC_LIBRARY_MEDIA_NEXT" desc="The Library" meaning="The next file in the media viewer">Next</message>
      <message name="IDS_CROMARC_LIBRARY_OPEN" desc="The Library">Open</message>
      <message name="IDS_CROMARC_LIBRARY_COPY" desc="The Library">Copy</message>

      <!-- Downloads: sizes, times and states (Firefox downloadUtils.ftl, Zen library). -->
      <message name="IDS_CROMARC_UNIT_BYTES" desc="Downloads: sizes, times and states (Firefox downloadUtils.ftl, Zen library)">bytes</message>
      <message name="IDS_CROMARC_UNIT_KILOBYTES" desc="Downloads: sizes, times and states (Firefox downloadUtils.ftl, Zen library)">KB</message>
      <message name="IDS_CROMARC_UNIT_MEGABYTES" desc="Downloads: sizes, times and states (Firefox downloadUtils.ftl, Zen library)">MB</message>
      <message name="IDS_CROMARC_UNIT_GIGABYTES" desc="Downloads: sizes, times and states (Firefox downloadUtils.ftl, Zen library)">GB</message>
      <message name="IDS_CROMARC_UNIT_TERABYTES" desc="Downloads: sizes, times and states (Firefox downloadUtils.ftl, Zen library)">TB</message>
      <message name="IDS_CROMARC_UNIT_SECONDS" desc="Downloads: sizes, times and states (Firefox downloadUtils.ftl, Zen library)">s</message>
      <message name="IDS_CROMARC_UNIT_MINUTES" desc="Downloads: sizes, times and states (Firefox downloadUtils.ftl, Zen library)">m</message>
      <message name="IDS_CROMARC_UNIT_HOURS" desc="Downloads: sizes, times and states (Firefox downloadUtils.ftl, Zen library)">h</message>
      <message name="IDS_CROMARC_UNIT_DAYS" desc="Downloads: sizes, times and states (Firefox downloadUtils.ftl, Zen library)">d</message>
      <message name="IDS_CROMARC_TIME_PAIR" desc="Downloads: sizes, times and states (Firefox downloadUtils.ftl, Zen library)"><ph name="TIME">$1<ex>14</ex></ph><ph name="UNIT">$2<ex>m</ex></ph></message>
      <message name="IDS_CROMARC_DOWNLOAD_SPEED" desc="Downloads: sizes, times and states (Firefox downloadUtils.ftl, Zen library)"><ph name="RATE">$1<ex>3.2</ex></ph> <ph name="UNIT">$2<ex>m</ex></ph>/s</message>
      <message name="IDS_CROMARC_DOWNLOAD_YESTERDAY" desc="Downloads: sizes, times and states (Firefox downloadUtils.ftl, Zen library)">Yesterday</message>
      <message name="IDS_CROMARC_DOWNLOAD_DANGEROUS" desc="Downloads: sizes, times and states (Firefox downloadUtils.ftl, Zen library)">This file may be dangerous</message>
      <message name="IDS_CROMARC_DOWNLOAD_PAUSED" desc="Downloads: sizes, times and states (Firefox downloadUtils.ftl, Zen library)">Paused</message>
      <message name="IDS_CROMARC_DOWNLOAD_MISSING" desc="Downloads: sizes, times and states (Firefox downloadUtils.ftl, Zen library)">File moved or missing</message>
      <message name="IDS_CROMARC_DOWNLOAD_CANCELED" desc="Downloads: sizes, times and states (Firefox downloadUtils.ftl, Zen library)">Canceled</message>
      <message name="IDS_CROMARC_DOWNLOAD_FAILED" desc="Downloads: sizes, times and states (Firefox downloadUtils.ftl, Zen library)">Failed</message>

      <!-- The command bar and the theme picker. -->
      <message name="IDS_CROMARC_COMMAND_BAR_PLACEHOLDER" desc="The command bar and the theme picker">Search or enter address</message>
      <message name="IDS_CROMARC_COMMAND_BAR_KIND_TAB" desc="The command bar and the theme picker">Switch to Tab</message>
      <message name="IDS_CROMARC_COMMAND_BAR_KIND_PINNED" desc="The command bar and the theme picker">Pinned</message>
      <message name="IDS_CROMARC_COMMAND_BAR_KIND_ARCHIVE" desc="The command bar and the theme picker">From archive</message>
      <message name="IDS_CROMARC_THEME_CLICK_TO_ADD" desc="The command bar and the theme picker">Click to add a color</message>

      <!-- The welcome page. -->
      <message name="IDS_CROMARC_WELCOME_TITLE" desc="The welcome page">Welcome to Cromarc</message>
      <message name="IDS_CROMARC_WELCOME_HELLO" desc="The welcome page">A browser in the spirit of Arc and Zen, where every space is a profile of its own, with its own extensions, passwords and cookies.</message>
      <message name="IDS_CROMARC_WELCOME_START" desc="The welcome page">Get Started</message>
      <message name="IDS_CROMARC_WELCOME_FIRST_SPACE" desc="The welcome page">This is your first space</message>
      <message name="IDS_CROMARC_WELCOME_ICON" desc="The welcome page">Icon</message>
      <message name="IDS_CROMARC_WELCOME_NEXT" desc="The welcome page">Next</message>
      <message name="IDS_CROMARC_WELCOME_MORE_TITLE" desc="The welcome page">Add more?</message>
      <message name="IDS_CROMARC_WELCOME_MORE_BODY" desc="The welcome page">Every space is a profile of its own: extensions go into it separately. For example, Bitwarden in your personal one and 1Password in your work one.</message>
      <message name="IDS_CROMARC_WELCOME_OWN" desc="The welcome page">Your own…</message>
      <message name="IDS_CROMARC_WELCOME_ADD" desc="The welcome page">Add</message>
      <message name="IDS_CROMARC_WELCOME_LATER" desc="The welcome page">Later</message>
      <message name="IDS_CROMARC_WELCOME_PERSONAL" desc="The welcome page">Personal</message>
      <message name="IDS_CROMARC_WELCOME_WORK" desc="The welcome page">Work</message>
      <message name="IDS_CROMARC_WELCOME_ARC_TITLE" desc="The welcome page">Import from Arc?</message>
      <message name="IDS_CROMARC_WELCOME_ARC_BODY" desc="The welcome page">Arc’s sidebar is here: its folders, pinned tabs and essentials can move into Cromarc’s spaces.</message>
      <message name="IDS_CROMARC_IMPORT_BUTTON" desc="The welcome page">Import</message>
      <message name="IDS_CROMARC_WELCOME_SKIP" desc="The welcome page">Skip</message>
      <message name="IDS_CROMARC_WELCOME_DEFAULT_TITLE" desc="The welcome page">Make Cromarc your default browser?</message>
      <message name="IDS_CROMARC_WELCOME_DEFAULT_BODY" desc="The welcome page">Then links from other apps open in a little window, like Little Arc, and “link → space” rules work.</message>
      <message name="IDS_CROMARC_WELCOME_IS_DEFAULT" desc="The welcome page">Cromarc is already your default browser.</message>
      <message name="IDS_CROMARC_WELCOME_MAKE_DEFAULT" desc="The welcome page">Make Default</message>
      <message name="IDS_CROMARC_WELCOME_NOT_NOW" desc="The welcome page">Not Now</message>
      <message name="IDS_CROMARC_WELCOME_DONE_TITLE" desc="The welcome page">All set</message>
      <message name="IDS_CROMARC_WELCOME_DONE_BODY" desc="The welcome page">⌘T — command bar, ⌘S — hide the sidebar, Ctrl+1…9 — spaces, two-finger swipe on the sidebar — the next space, ⌥-click on a link — Glance.</message>
      <message name="IDS_CROMARC_WELCOME_FINISH" desc="The welcome page">Start Browsing</message>

      <!-- Import from Arc. -->
      <message name="IDS_CROMARC_ARC_IMPORT_TITLE" desc="Import from Arc">Import from Arc</message>
      <message name="IDS_CROMARC_ARC_IMPORT_HINT" desc="Import from Arc">Folders, pinned and essential tabs, Today tabs (they open without loading). You can run it again: what was imported is not duplicated.</message>
      <message name="IDS_CROMARC_ARC_IMPORT_EXPORT_HINT" desc="Import from Arc">From an Arc export file: it holds only links. Favorites are pinned at the root of the space; tab titles appear once you open them.</message>
      <message name="IDS_CROMARC_ARC_IMPORT_LOADING" desc="Import from Arc">Reading Arc’s sidebar…</message>
      <message name="IDS_CROMARC_ARC_IMPORT_MISSING" desc="Import from Arc">Arc’s data was not found (~/Library/Application Support/Arc/StorableSidebar.json). If Arc is already deleted, import from its export file: Arc → Settings → Advanced → Export Data.</message>
      <message name="IDS_CROMARC_ARC_IMPORT_OR_FROM_EXPORT" desc="Import from Arc">Or from an Arc export file…</message>
      <message name="IDS_CROMARC_ARC_IMPORT_CHOOSE_EXPORT" desc="Import from Arc">Choose an export file…</message>
      <message name="IDS_CROMARC_ARC_IMPORT_EXPORT_FAILED" desc="Import from Arc">No file was chosen, or it is not an Arc export.</message>
      <message name="IDS_CROMARC_ARC_IMPORT_NEW_SPACE" desc="Import from Arc">New space</message>
      <message name="IDS_CROMARC_ARC_IMPORT_SKIP" desc="Import from Arc">Don’t import</message>
      <message name="IDS_CROMARC_ARC_IMPORT_IMPORTING" desc="Import from Arc">Importing…</message>
      <message name="IDS_CROMARC_ARC_IMPORT_THIS_SPACE" desc="Import from Arc">(this one)</message>
      <message name="IDS_CROMARC_ARC_IMPORT_NOTHING" desc="Import from Arc">Nothing to import.</message>
      <message name="IDS_CROMARC_ARC_IMPORT_EXPORT_FILE" desc="Import from Arc">Arc Export File</message>
      <message name="IDS_CROMARC_ARC_IMPORT_FOLDERS" desc="Import from Arc">Folders <ph name="COUNT">$1<ex>3</ex></ph></message>
      <message name="IDS_CROMARC_ARC_IMPORT_PINNED" desc="Import from Arc">Pinned <ph name="COUNT">$1<ex>3</ex></ph></message>
      <message name="IDS_CROMARC_ARC_IMPORT_ESSENTIALS" desc="Import from Arc">Essentials <ph name="COUNT">$1<ex>3</ex></ph></message>
      <message name="IDS_CROMARC_ARC_IMPORT_TODAY" desc="Import from Arc">Today <ph name="COUNT">$1<ex>3</ex></ph></message>
      <message name="IDS_CROMARC_ARC_IMPORT_SKIPPED" desc="Import from Arc">Already there <ph name="COUNT">$1<ex>3</ex></ph></message>

      <!-- Little windows and Glance. -->
      <message name="IDS_CROMARC_LITTLE_OPEN_IN" desc="Little windows and Glance">Open in <ph name="SPACE">$1<ex>Work</ex></ph></message>
      <message name="IDS_CROMARC_LITTLE_OPEN_IN_ANOTHER" desc="Little windows and Glance">Open in another space</message>
      <message name="IDS_CROMARC_LITTLE_CLOSE" desc="Little windows and Glance">Close (goes to the archive)</message>
      <message name="IDS_CROMARC_LITTLE_ALWAYS_OPEN" desc="Little windows and Glance">Always open <ph name="HOST">$1<ex>example.com</ex></ph> in “<ph name="SPACE">$2<ex>Work</ex></ph>”</message>
      <message name="IDS_CROMARC_GLANCE_OPEN_AS_TAB" desc="Little windows and Glance">Open as Tab</message>
      <message name="IDS_CROMARC_GLANCE_CLOSE" desc="Little windows and Glance">Close (Esc)</message>
      <message name="IDS_CROMARC_GLANCE_CONFIRM" desc="Little windows and Glance: beside the glance's close button while Esc in a text field asks to confirm, Zen's words">Confirm</message>
      <message name="IDS_CROMARC_GLANCE_OPEN_LINK" desc="Little windows and Glance: the page context menu item, Zen's words">Open Link in Glance</message>
      <message name="IDS_CROMARC_LITTLE_MOVE_WINDOW" desc="Little windows and Glance: the Little window, as a Little window, moves to the space">Move window to “<ph name="SPACE">$1<ex>Work</ex></ph>”</message>
      <message name="IDS_CROMARC_LITTLE_MOVE_WINDOW_TOOLTIP" desc="Little windows and Glance: the space button of a Little window">Move this window to another space</message>
    </messages>
  </release>
</grit>
