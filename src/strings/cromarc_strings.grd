      <message name="IDS_CROMARC_LIBRARY_ROUTING_SAVE" desc="The Library">Save route</message>
      <message name="IDS_CROMARC_LIBRARY_ROUTING_REMOVE" desc="The Library">Remove route</message>
      <message name="IDS_CROMARC_LIBRARY_ROUTING_EXTERNAL_LINKS" desc="The Library">Default route for external links</message>
      <message name="IDS_CROMARC_LIBRARY_ROUTING_EMPTY" desc="The Library">Routes send links to the space you keep them in. Add one for a site you always open in the same place.</message>
      <message name="IDS_CROMARC_LIBRARY_ROUTING_NO_RESULTS" desc="The Library">No routes found</message>
      <message name="IDS_CROMARC_LIBRARY_DOWNLOADS_SEARCH" desc="The Library">Search downloads</message>
