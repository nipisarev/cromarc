<!-- Cromarc's UI strings, in English. Their Russian is in
     translations/cromarc_strings_ru.xtb, under ids grit computes from the
     English (and the meaning, where one English text needs two
     translations). Chromium packs them into each locale's pak (hook H20), so
     they come in the language Chromium's own UI uses. Other locales show the
     English. -->
<grit base_dir="." latest_public_release="0" current_release="1"
      source_lang_id="en" enc_check="möl">
  <outputs>
    <output filename="grit/cromarc_strings.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/cromarc_strings_map.h" type="resource_map_header" />
    <output filename="grit/cromarc_strings_map.cc" type="resource_map_source" />
    <output filename="cromarc_strings_af.pak" type="data_package" lang="af" />
    <output filename="cromarc_strings_am.pak" type="data_package" lang="am" />
    <output filename="cromarc_strings_ar.pak" type="data_package" lang="ar" />
    <output filename="cromarc_strings_as.pak" type="data_package" lang="as" />
