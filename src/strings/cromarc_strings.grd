  <release seq="1">
    <messages fallback_to_english="true">
      <!-- The sidebar and its menus. -->
      <message name="IDS_CROMARC_NEW_TAB" desc="The sidebar and its menus">New Tab</message>
      <message name="IDS_CROMARC_NEW_FOLDER" desc="The sidebar and its menus">New Folder</message>
      <message name="IDS_CROMARC_IMPORT_FROM_ARC" desc="The sidebar and its menus">Import from Arc…</message>
      <message name="IDS_CROMARC_HIDE_SIDEBAR" desc="The sidebar and its menus">Hide sidebar  ⌘S</message>
      <message name="IDS_CROMARC_SPACE_ACTIONS" desc="The sidebar and its menus">Space Actions</message>
      <message name="IDS_CROMARC_EDIT_SPACE" desc="The sidebar and its menus">Change Name…</message>
      <message name="IDS_CROMARC_CHANGE_ICON" desc="The sidebar and its menus">Change Icon…</message>
      <message name="IDS_CROMARC_EDIT_THEME" desc="The sidebar and its menus">Edit Theme…</message>
      <message name="IDS_CROMARC_SLEEP_SPACE" desc="The sidebar and its menus">Unload Space</message>
      <message name="IDS_CROMARC_DELETE_SPACE" desc="The sidebar and its menus">Delete Space</message>
      <message name="IDS_CROMARC_DELETE_SPACE_TITLE" desc="The sidebar and its menus">Delete Space?</message>
      <message name="IDS_CROMARC_DELETE_SPACE_BODY" desc="The sidebar and its menus">Delete “<ph name="SPACE">$1<ex>Work</ex></ph>”? This space’s tabs, history, extensions and site data will be gone. This cannot be undone.</message>
      <message name="IDS_CROMARC_DELETE" desc="The sidebar and its menus">Delete</message>
      <message name="IDS_CROMARC_CANCEL" desc="The sidebar and its menus">Cancel</message>
      <message name="IDS_CROMARC_CREATE_NEW" desc="The sidebar and its menus">Create New</message>
      <message name="IDS_CROMARC_NEW_SPACE" desc="The sidebar and its menus">Create Space</message>
      <message name="IDS_CROMARC_CREATE_FOLDER" desc="The sidebar and its menus">Create Folder</message>
      <message name="IDS_CROMARC_LIBRARY" desc="The sidebar and its menus">Library</message>
      <message name="IDS_CROMARC_ICLOUD_SYNC" desc="The sidebar and its menus">Sync with iCloud…</message>
      <message name="IDS_CROMARC_ICLOUD_TITLE" desc="The sidebar and its menus">iCloud Drive</message>
      <message name="IDS_CROMARC_ICLOUD_BODY" desc="The sidebar and its menus">This space’s bookmarks and tree, history, settings, list of extensions and tabs live in iCloud Drive/Cromarc and reach your other Mac. Passwords stay in your password manager. One Mac at a time: before you work on another Mac, quit Cromarc on this one.</message>
      <message name="IDS_CROMARC_ICLOUD_ON" desc="The sidebar and its menus">On</message>
      <message name="IDS_CROMARC_ICLOUD_OFF" desc="The sidebar and its menus">Off</message>
      <message name="IDS_CROMARC_ICLOUD_ON_AFTER_RESTART" desc="The sidebar and its menus">Turns on after a restart</message>
      <message name="IDS_CROMARC_ICLOUD_OFF_AFTER_RESTART" desc="The sidebar and its menus">Turns off after a restart</message>
      <message name="IDS_CROMARC_ICLOUD_ENABLE" desc="The sidebar and its menus">Turn On</message>
      <message name="IDS_CROMARC_ICLOUD_DISABLE" desc="The sidebar and its menus">Turn Off</message>
      <message name="IDS_CROMARC_RESTART" desc="The sidebar and its menus">Restart</message>
      <message name="IDS_CROMARC_TODAY" desc="The sidebar and its menus" meaning="The section of unpinned tabs">Today</message>
      <message name="IDS_CROMARC_RENAME" desc="The sidebar and its menus">Rename</message>
      <message name="IDS_CROMARC_REMOVE" desc="The sidebar and its menus">Remove</message>
      <message name="IDS_CROMARC_RESET_PINNED" desc="The sidebar and its menus">Reset Pinned Tab</message>
      <message name="IDS_CROMARC_RESET_ESSENTIAL" desc="The sidebar and its menus">Reset Essential Tab</message>
      <message name="IDS_CROMARC_REPLACE_WITH_CURRENT" desc="The sidebar and its menus">Replace with Current URL</message>
      <message name="IDS_CROMARC_RESET_PIN_BUTTON" desc="The sidebar and its menus">Reset and pin tab</message>
      <message name="IDS_CROMARC_BACK_TO_PINNED" desc="The sidebar and its menus">Back to pinned url</message>
      <message name="IDS_CROMARC_SEPARATE_FROM_PINNED" desc="The sidebar and its menus">Separate from pinned tab</message>
      <message name="IDS_CROMARC_UNPIN" desc="The sidebar and its menus">Unpin Tab</message>
      <message name="IDS_CROMARC_PIN" desc="The sidebar and its menus">Pin Tab</message>
      <message name="IDS_CROMARC_COPY_LINK" desc="The sidebar and its menus">Copy Link</message>
      <message name="IDS_CROMARC_ADD_TO_ESSENTIALS" desc="The sidebar and its menus">Add to Essentials</message>
      <message name="IDS_CROMARC_REMOVE_FROM_ESSENTIALS" desc="The sidebar and its menus">Remove from Essentials</message>
      <message name="IDS_CROMARC_ESSENTIALS_PROMO_SUBLABEL" desc="The sidebar and its menus">Keep your favorite tabs just a click away</message>
      <message name="IDS_CROMARC_CLOSE" desc="The sidebar and its menus">Close</message>
      <message name="IDS_CROMARC_CLEAR" desc="The sidebar and its menus">Clear</message>
      <message name="IDS_CROMARC_CLEAR_TOOLTIP" desc="The sidebar and its menus">Close all unpinned tabs</message>
      <message name="IDS_CROMARC_CLEARED" desc="The sidebar and its menus">Tabs closed</message>
      <message name="IDS_CROMARC_UNDO" desc="The sidebar and its menus">Undo</message>
      <message name="IDS_CROMARC_NEEDS_ATTENTION" desc="The sidebar and its menus">Needs attention</message>
      <message name="IDS_CROMARC_UNSAVED_INPUT" desc="The sidebar and its menus">not closed: unsaved input</message>
      <message name="IDS_CROMARC_CLOSE_ANYWAY" desc="The sidebar and its menus">Close Anyway</message>
      <message name="IDS_CROMARC_KEEP" desc="The sidebar and its menus">Keep</message>
      <message name="IDS_CROMARC_ARCHIVES_IN" desc="The sidebar and its menus">goes to the archive in <ph name="MINUTES">$1<ex>5</ex></ph> min</message>

      <!-- The space editor and the icon picker. -->
      <message name="IDS_CROMARC_CREATE_SPACE_TITLE" desc="The space editor and the icon picker">Create a Space</message>
      <message name="IDS_CROMARC_EDIT_SPACE_TITLE" desc="The space editor and the icon picker">Edit Space</message>
      <message name="IDS_CROMARC_CREATE_SPACE_LABEL" desc="The space editor and the icon picker">Spaces are used to organize your tabs and sessions.</message>
      <message name="IDS_CROMARC_SPACE_NAME" desc="The space editor and the icon picker">Space Name</message>
      <message name="IDS_CROMARC_REMOTE_SPACES" desc="The space editor and the icon picker">In iCloud Drive — connect from this Mac:</message>
      <message name="IDS_CROMARC_SAVE" desc="The space editor and the icon picker">Save</message>
      <message name="IDS_CROMARC_EMOJIS" desc="The space editor and the icon picker">Emojis</message>
      <message name="IDS_CROMARC_ICONS" desc="The space editor and the icon picker">Icons</message>
      <message name="IDS_CROMARC_NO_ICON" desc="The space editor and the icon picker">No icon</message>
      <message name="IDS_CROMARC_SEARCH_EMOJIS" desc="The space editor and the icon picker">Search emojis</message>

      <!-- The Library. -->
      <message name="IDS_CROMARC_LIBRARY_CLOSE" desc="The Library">Close library</message>
      <message name="IDS_CROMARC_LIBRARY_CUSTOMIZE" desc="The Library">Choose tabs</message>
      <message name="IDS_CROMARC_LIBRARY_REMOVE_TAB" desc="The Library">Take this tab out</message>
      <message name="IDS_CROMARC_LIBRARY_RESTORE_TAB" desc="The Library">Put this tab back</message>
      <message name="IDS_CROMARC_LIBRARY_HISTORY" desc="The Library">History</message>
      <message name="IDS_CROMARC_LIBRARY_ARCHIVE" desc="The Library">Archive</message>
      <message name="IDS_CROMARC_LIBRARY_DOWNLOADS" desc="The Library">Downloads</message>
      <message name="IDS_CROMARC_LIBRARY_MEDIA" desc="The Library">Media</message>
      <message name="IDS_CROMARC_LIBRARY_SPACES" desc="The Library">Spaces</message>
      <message name="IDS_CROMARC_LIBRARY_ROUTING" desc="The Library">Routing</message>
      <message name="IDS_CROMARC_LIBRARY_FILTER" desc="The Library">Filter</message>
      <message name="IDS_CROMARC_LIBRARY_DONE" desc="The Library">Done</message>
      <message name="IDS_CROMARC_LIBRARY_TODAY" desc="The Library" meaning="A time range">Today</message>
      <message name="IDS_CROMARC_LIBRARY_WEEK" desc="The Library">This Week</message>
      <message name="IDS_CROMARC_LIBRARY_MONTH" desc="The Library">This Month</message>
      <message name="IDS_CROMARC_LIBRARY_OPENED_IN_BACKGROUND" desc="The Library">Opened tab in a new tab</message>
      <message name="IDS_CROMARC_LIBRARY_HISTORY_CLEAR" desc="The Library">Clear history</message>
      <message name="IDS_CROMARC_LIBRARY_CLEAR_LAST_HOUR" desc="The Library">Last hour</message>
      <message name="IDS_CROMARC_LIBRARY_CLEAR_LAST12_HOURS" desc="The Library">Last 12 hours</message>
      <message name="IDS_CROMARC_LIBRARY_CLEAR_LAST_WEEK" desc="The Library">Last week</message>
      <message name="IDS_CROMARC_LIBRARY_CLEAR_LAST_MONTH" desc="The Library">Last month</message>
      <message name="IDS_CROMARC_LIBRARY_CLEAR_ALL" desc="The Library">Everything</message>
      <message name="IDS_CROMARC_LIBRARY_CLEAR_PROMPT_TITLE" desc="The Library">Clear history?</message>
      <message name="IDS_CROMARC_LIBRARY_CLEAR_PROMPT_MESSAGE" desc="The Library">The pages you visited in this time frame will be forgotten. This cannot be undone.</message>
      <message name="IDS_CROMARC_LIBRARY_OPEN_LEGACY_HISTORY" desc="The Library">Open the “History” page</message>
      <message name="IDS_CROMARC_LIBRARY_OPEN_LEGACY_DOWNLOADS" desc="The Library">Open the “Downloads” page</message>
      <message name="IDS_CROMARC_LIBRARY_HISTORY_FILTER_TITLE" desc="The Library">Filter History…</message>
      <message name="IDS_CROMARC_LIBRARY_HISTORY_FILTER_WHEN" desc="The Library">When was it visited?</message>
      <message name="IDS_CROMARC_LIBRARY_HISTORY_FILTER_SOURCE" desc="The Library">What to look through</message>
      <message name="IDS_CROMARC_LIBRARY_SOURCE_CLOSED" desc="The Library">Closed tabs</message>
