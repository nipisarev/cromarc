# What Chromium's own files include and call (patches/hooks). Declarations
# only, so any upstream target may include it without a dependency cycle.
source_set("hooks") {
  sources = [ "hooks.h" ]
  public_deps = [
    "//base",
    "//ui/gfx/geometry",
  ]
}

source_set("impl") {
  sources = [ "hooks.cc" ]
  public_deps = [ "//chrome/browser:browser_public_dependencies" ]
  deps = [
    ":hooks",
    "//chrome/app/vector_icons",
    "//cromarc/browser:keyed_services",
    "//cromarc/browser/chromium",
    "//cromarc/browser/ui:browser_commands",
    "//cromarc/browser/ui:webui_registration",
    "//cromarc/browser/ui/glance",
    "//cromarc/browser/ui/sidebar",
    "//components/renderer_context_menu",
    "//content/public/browser",
    "//ui/base",
    "//ui/compositor",
    "//ui/views",
  ]
}
